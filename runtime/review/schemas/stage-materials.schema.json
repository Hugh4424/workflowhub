{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wh-review stage material matrix",
  "type": "object",
  "required": [
    "version",
    "surfaces",
    "stages",
    "mini_task",
    "non_stage"
  ],
  "properties": {
    "version": {
      "const": "wh-review-stage-materials.v2"
    },
    "surfaces": {
      "type": "object",
      "required": [
        "make-decision/direction",
        "make-decision/detail",
        "build-plan",
        "build-code/phase",
        "verify-code",
        "mini-task/design",
        "mini-task/implementation",
        "build-prd"
      ],
      "properties": {
        "make-decision/direction": {
          "$ref": "#/$defs/surface"
        },
        "make-decision/detail": {
          "$ref": "#/$defs/surface"
        },
        "build-plan": {
          "$ref": "#/$defs/surface"
        },
        "build-code/phase": {
          "$ref": "#/$defs/surface"
        },
        "verify-code": {
          "$ref": "#/$defs/surface"
        },
        "mini-task/design": {
          "$ref": "#/$defs/surface"
        },
        "mini-task/implementation": {
          "$ref": "#/$defs/surface"
        },
        "build-prd": {
          "$ref": "#/$defs/surface"
        }
      },
      "additionalProperties": false
    },
    "stages": {
      "type": "object",
      "required": [
        "make-decision",
        "build-plan",
        "build-code",
        "verify-code"
      ],
      "properties": {
        "make-decision": {
          "type": "object",
          "required": [
            "tracks"
          ],
          "properties": {
            "tracks": {
              "type": "object",
              "required": [
                "direction",
                "detail"
              ],
              "properties": {
                "direction": {
                  "$ref": "#/$defs/rule"
                },
                "detail": {
                  "$ref": "#/$defs/rule"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "build-plan": {
          "$ref": "#/$defs/buildPlanRule"
        },
        "build-code": {
          "$ref": "#/$defs/buildCodeProfiles"
        },
        "verify-code": {
          "$ref": "#/$defs/rule"
        }
      },
      "additionalProperties": false
    },
    "non_stage": {
      "type": "object",
      "required": [
        "build_prd"
      ],
      "properties": {
        "build_prd": {
          "$ref": "#/$defs/rule"
        }
      },
      "additionalProperties": false
    },
    "mini_task": {
      "type": "object",
      "required": [
        "design",
        "implementation"
      ],
      "properties": {
        "design": {
          "$ref": "#/$defs/rule"
        },
        "implementation": {
          "$ref": "#/$defs/miniImplementationRule"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "required": [
        "contract",
        "problem_order",
        "semantic_fields"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "minLength": 1
        },
        "problem_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semantic_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": [
        "source_bundle",
        "required",
        "optional",
        "generated",
        "forbidden"
      ],
      "properties": {
        "source_bundle": {
          "enum": [
            "none",
            "diff"
          ]
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generated": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "buildPlanRule": {
      "type": "object",
      "required": [
        "source_bundle",
        "required",
        "optional",
        "generated",
        "forbidden",
        "profiles"
      ],
      "properties": {
        "source_bundle": {
          "const": "none"
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "contains": {
            "const": "draft_tasks"
          },
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "optional": {
          "type": "array",
          "uniqueItems": true,
          "not": {
            "contains": {
              "const": "draft_tasks"
            },
            "type": "array"
          },
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generated": {
          "type": "array",
          "uniqueItems": true,
          "not": {
            "contains": {
              "const": "draft_tasks"
            },
            "type": "array"
          },
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden": {
          "type": "array",
          "uniqueItems": true,
          "not": {
            "contains": {
              "const": "draft_tasks"
            },
            "type": "array"
          },
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "profiles": {
          "type": "object",
          "required": [
            "post"
          ],
          "properties": {
            "post": {
              "allOf": [
                {
                  "$ref": "#/$defs/rule"
                },
                {
                  "properties": {
                    "required": {
                      "allOf": [
                        {
                          "contains": {
                            "const": "draft_spec"
                          },
                          "type": "array"
                        },
                        {
                          "contains": {
                            "const": "phase_authorities"
                          },
                          "type": "array"
                        },
                        {
                          "contains": {
                            "const": "phase_index"
                          },
                          "type": "array"
                        }
                      ]
                    },
                    "forbidden": {
                      "allOf": [
                        {
                          "contains": {
                            "const": "draft_plan"
                          },
                          "type": "array"
                        },
                        {
                          "contains": {
                            "const": "draft_tasks"
                          },
                          "type": "array"
                        },
                        {
                          "contains": {
                            "const": "approved_spec"
                          },
                          "type": "array"
                        }
                      ]
                    }
                  },
                  "type": "object"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "buildCodeProfiles": {
      "type": "object",
      "required": [
        "profiles"
      ],
      "properties": {
        "profiles": {
          "type": "object",
          "required": [
            "phase"
          ],
          "properties": {
            "phase": {
              "$ref": "#/$defs/phaseRule"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "phaseRule": {
      "allOf": [
        {
          "$ref": "#/$defs/rule"
        },
        {
          "properties": {
            "source_bundle": {
              "const": "diff"
            },
            "required": {
              "contains": {
                "const": "test_evidence"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      ]
    },
    "miniImplementationRule": {
      "allOf": [
        {
          "$ref": "#/$defs/rule"
        },
        {
          "properties": {
            "source_bundle": {
              "const": "diff"
            }
          },
          "allOf": [
            {
              "properties": {
                "required": {
                  "contains": {
                    "const": "test_evidence"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "properties": {
                "required": {
                  "contains": {
                    "const": "ac_trace"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "properties": {
                "required": {
                  "contains": {
                    "const": "user_result"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "properties": {
                "required": {
                  "contains": {
                    "const": "coverage_limits"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "properties": {
                "required": {
                  "contains": {
                    "const": "skip_reasons"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "properties": {
                "required": {
                  "contains": {
                    "const": "remaining_risks"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            }
          ],
          "type": "object"
        }
      ]
    }
  },
  "additionalProperties": false
}
