{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wh-review stage material matrix",
  "type": "object",
  "required": ["version", "stages", "mini_task"],
  "properties": {
    "version": { "const": "wh-review-stage-materials.v2" },
    "stages": {
      "type": "object",
      "required": ["make-decision", "build-spec", "build-plan", "build-code", "verify-code"],
      "properties": {
        "make-decision": {
          "type": "object",
          "required": ["tracks"],
          "properties": {
            "tracks": {
              "type": "object",
              "required": ["direction", "detail"],
              "properties": {
                "direction": { "$ref": "#/$defs/rule" },
                "detail": { "$ref": "#/$defs/rule" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "build-spec": { "$ref": "#/$defs/rule" },
        "build-plan": { "$ref": "#/$defs/buildPlanRule" },
        "build-code": { "$ref": "#/$defs/buildCodeProfiles" },
        "verify-code": { "$ref": "#/$defs/rule" }
      },
      "additionalProperties": false
    },
    "mini_task": {
      "type": "object",
      "required": ["design", "implementation"],
      "properties": {
        "design": { "$ref": "#/$defs/rule" },
        "implementation": { "$ref": "#/$defs/miniImplementationRule" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["source_bundle", "required", "optional", "generated", "forbidden", "minimum_reviewers", "v2_required_maps"],
      "properties": {
        "source_bundle": { "enum": ["none", "diff"] },
        "required": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "optional": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "generated": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "forbidden": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "minimum_reviewers": { "type": "integer", "minimum": 1 },
        "v2_required_maps": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "buildPlanRule": {
      "allOf": [
        { "$ref": "#/$defs/rule" },
        {
          "properties": {
            "required": {
              "contains": { "const": "draft_tasks" }
            },
            "optional": {
              "not": { "contains": { "const": "draft_tasks" } }
            },
            "generated": {
              "not": { "contains": { "const": "draft_tasks" } }
            },
            "forbidden": {
              "not": { "contains": { "const": "draft_tasks" } }
            }
          }
        }
      ]
    },
    "buildCodeProfiles": {
      "type": "object",
      "required": ["profiles"],
      "properties": {
        "profiles": {
          "type": "object",
          "required": ["phase", "integration"],
          "properties": {
            "phase": { "$ref": "#/$defs/phaseRule" },
            "integration": { "$ref": "#/$defs/integrationRule" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "phaseRule": {
      "allOf": [
        { "$ref": "#/$defs/rule" },
        {
          "properties": {
            "source_bundle": { "const": "diff" },
            "required": { "contains": { "const": "test_evidence" } }
          }
        }
      ]
    },
    "integrationRule": {
      "allOf": [
        { "$ref": "#/$defs/rule" },
        {
          "properties": {
            "source_bundle": { "const": "none" },
            "required": {
              "allOf": [
                { "contains": { "const": "test_evidence" } },
                { "contains": { "const": "ac_trace" } },
                { "not": { "contains": { "const": "phase_coverage" } } },
                { "not": { "contains": { "const": "seam_index" } } },
                { "not": { "contains": { "const": "phase_map_trace" } } }
              ]
            },
            "forbidden": {
              "allOf": [
                { "contains": { "const": "changes_diff" } },
                { "contains": { "const": "cumulative_diff" } },
                { "contains": { "const": "phase_diff" } },
                { "contains": { "const": "integration_map" } }
              ]
            }
          }
        }
      ]
    },
    "miniImplementationRule": {
      "allOf": [
        { "$ref": "#/$defs/rule" },
        {
          "properties": {
            "source_bundle": { "const": "diff" }
          },
          "allOf": [
            { "properties": { "required": { "contains": { "const": "test_evidence" } } } },
            { "properties": { "required": { "contains": { "const": "ac_trace" } } } },
            { "properties": { "required": { "contains": { "const": "user_result" } } } },
            { "properties": { "required": { "contains": { "const": "coverage_limits" } } } },
            { "properties": { "required": { "contains": { "const": "skip_reasons" } } } },
            { "properties": { "required": { "contains": { "const": "remaining_risks" } } } }
          ]
        }
      ]
    }
  },
  "additionalProperties": false
}
