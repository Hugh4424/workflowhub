{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wh-review per-acceptance evidence summary",
  "type": "object",
  "required": ["schema_version", "snapshot_tree", "source_digest", "test_receipt", "criteria"],
  "properties": {
    "schema_version": { "const": "ac-evidence-summary.v1" },
    "snapshot_tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "test_receipt": { "$ref": "#/$defs/ref" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/criterion" }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["ref", "sha256"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "required": ["acceptance_criterion_id", "result", "leaf_result", "status", "source_digest", "acceptance_leaf", "nested_evidence", "scenario", "oracle", "actual_outcome", "evidence_type", "coverage_limits", "exceptions"],
      "properties": {
        "acceptance_criterion_id": { "type": "string", "minLength": 1 },
        "result": { "enum": ["pass", "fail", "inconclusive", "deferred", "unknown"] },
        "leaf_result": { "enum": ["pass", "fail", "inconclusive", "deferred"] },
        "status": { "enum": ["passed", "failed", "unknown", "unavailable", "incomplete", "missing"] },
        "source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "acceptance_leaf": { "$ref": "#/$defs/ref" },
        "nested_evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } },
        "scenario": { "type": "string", "minLength": 1 },
        "oracle": { "type": "string", "minLength": 1 },
        "actual_outcome": { "type": "string", "minLength": 1 },
        "evidence_type": { "enum": ["acceptance_leaf", "structured_observation", "unknown"] },
        "coverage_limits": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "exceptions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "implementation_anchor": { "$ref": "#/$defs/anchor" },
        "verification_anchor": { "$ref": "#/$defs/anchor" }
      },
      "additionalProperties": false
    },
    "anchor": {
      "type": "object",
      "required": ["id", "path", "start_line", "end_line", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "role": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
