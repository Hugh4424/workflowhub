{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wh-review non-gate response record",
  "type": "object",
  "required": ["version", "task_id", "stage", "review_track", "outcome", "previous_verdict", "provider_calls", "previous_result_ref", "previous_result_sha256", "previous_snapshot_tree", "snapshot_tree", "evidence_state", "response_ledger", "response_ledger_sha256", "unverified_reason", "accepted_risk_count"],
  "properties": {
    "version": { "const": "wh-review-resolution.v1" },
    "task_id": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["make-decision", "build-spec", "build-plan", "build-code", "verify-code"] },
    "review_track": { "enum": ["direction", "detail", null] },
    "outcome": { "const": "recorded_non_gate_response" },
    "previous_verdict": { "enum": ["pass", "revise_required"] },
    "provider_calls": { "const": 0 },
    "previous_result_ref": { "type": "string", "pattern": "^(?:quality/reviews|reviews)/results/[A-Za-z0-9._-]+\\.json$" },
    "previous_result_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "previous_snapshot_tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "snapshot_tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "evidence_state": { "enum": ["verified", "unverified"] },
    "response_ledger": { "type": ["object", "null"] },
    "response_ledger_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "unverified_reason": { "type": ["string", "null"], "minLength": 1 },
    "accepted_risk_count": { "type": "integer", "minimum": 0 },
    "change_classification": {
      "type": "object",
      "required": ["version", "source", "previous_snapshot_tree", "current_snapshot_tree", "source_diff_sha256", "previous_manifest", "current_manifest", "changed_dimensions", "structural"],
      "properties": {
        "version": { "const": "wh-review-change-classification.v1" },
        "source": { "const": "frozen_bundle_manifest" },
        "previous_snapshot_tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "current_snapshot_tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "source_diff_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "previous_manifest": { "type": ["object", "null"] },
        "current_manifest": { "type": "object" },
        "changed_dimensions": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["direction", "acceptance_criteria", "interface", "schema", "state", "security", "concurrency", "topology", "phase_order", "test_strategy"] }
        },
        "structural": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [{
    "if": { "properties": { "stage": { "const": "make-decision" } }, "required": ["stage"] },
    "then": { "properties": { "review_track": { "enum": ["direction", "detail"] } } },
    "else": { "properties": { "review_track": { "type": "null" } } }
  }],
  "additionalProperties": false
}
