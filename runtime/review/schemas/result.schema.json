                "minimum": 0
              },
              "providers_failed": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "verdict": false
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "findings": {
                  "type": "array",
                  "maxItems": 0
                }
              },
              "required": [
                "findings"
