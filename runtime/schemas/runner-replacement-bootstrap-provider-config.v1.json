{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "runner-replacement-bootstrap-provider-config.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_hash", "ordered_providers", "mode", "minimum_heterologous", "profiles", "secret_free"],
  "properties": {
    "schema_version": {"const": "runner-replacement-bootstrap-provider-config.v1"},
    "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ordered_providers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[^/]+/[^/]+$"}
    },
    "mode": {"const": "full_only"},
    "minimum_heterologous": {"type": "integer", "minimum": 1},
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "effort", "thinking", "priority"],
        "properties": {
          "model": {"type": "string", "minLength": 1},
          "effort": {"type": ["string", "null"]},
          "thinking": {"type": ["boolean", "null"]},
          "priority": {"type": "integer", "minimum": 1}
        }
      }
    },
    "secret_free": {"const": true}
  }
}
