{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "risk-acceptance.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "stage",
    "workflow_run_id",
    "snapshot_tree",
    "review_ref",
    "review_hash",
    "review_verdict",
    "finding_ref",
    "finding_id",
    "finding_hash",
    "evidence_ref",
    "evidence_hash",
    "issue",
    "impact_scope",
    "consequences",
    "card_ref",
    "card_hash",
    "selected_option",
    "reply_ref",
    "reply_hash",
    "accepted_at"
  ],
  "properties": {
    "schema_version": { "const": "risk-acceptance.v1" },
    "task_id": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["make-decision", "build-spec", "build-plan", "build-code", "verify-code"] },
    "workflow_run_id": { "type": "string", "minLength": 1 },
    "snapshot_tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "review_ref": { "type": "string", "pattern": "^quality/reviews/results/[A-Za-z0-9._-]+\\.json$" },
    "review_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "review_verdict": { "enum": ["pass", "revise_required"] },
    "finding_ref": { "type": "string", "minLength": 1 },
    "finding_id": { "type": "string", "pattern": "^F-[a-f0-9]{12,16}$" },
    "finding_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence_ref": { "type": "string", "minLength": 1 },
    "evidence_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "issue": { "type": "string", "minLength": 1 },
    "impact_scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "consequences": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "card_ref": { "type": "string", "minLength": 1 },
    "card_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "selected_option": { "const": "accept-risk" },
    "reply_ref": { "type": "string", "minLength": 1 },
    "reply_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "accepted_at": { "type": "string", "format": "date-time" }
  }
}
