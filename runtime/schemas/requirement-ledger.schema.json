{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflowhub/requirement-ledger.schema.json",
  "type": "object",
  "required": ["schema_version", "source_manifest_hash", "requirements", "ledger_hash"],
  "properties": {
    "schema_version": { "const": "v1" },
    "source_manifest_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ledger_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirement_id", "status", "source_ref", "decision_ref", "artifact_refs", "acceptance_criteria_refs", "content_hash", "upstream_hashes", "stale"],
        "properties": {
          "requirement_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["accepted", "withdrawn", "rejected", "unknown"] },
          "source_ref": { "$ref": "#/$defs/evidenceRef" },
          "decision_ref": { "$ref": "#/$defs/evidenceRef" },
          "artifact_refs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
          "acceptance_criteria_refs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
          "content_hash": { "type": "string", "minLength": 1 },
          "upstream_hashes": { "type": "array", "items": { "type": "string" } },
          "stale": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "accepted" } }, "required": ["status"] },
            "then": {
              "properties": {
                "artifact_refs": { "minItems": 1 },
                "acceptance_criteria_refs": { "minItems": 1 }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "required": ["kind", "uri_or_path", "content_hash"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "uri_or_path": { "type": "string", "minLength": 1 },
        "content_hash": { "type": "string", "minLength": 1 },
        "stale": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
