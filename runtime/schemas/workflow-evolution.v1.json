{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflowhub://schemas/workflow-evolution.v1.json",
  "title": "WorkflowHub M16 workflow evolution contracts",
  "type": "object",
  "required": ["$defs"],
  "$defs": {
    "target_ref": {
      "type": "object",
      "required": ["project_id", "target_kind", "target_id", "target_version", "authority_ref", "authority_sha256"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "target_kind": {"enum": ["stage", "step", "skill", "surface"]},
        "target_id": {"type": "string", "minLength": 1},
        "target_version": {"type": ["string", "null"]},
        "authority_ref": {"type": "string", "minLength": 1},
        "authority_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"target_kind": {"enum": ["stage", "surface"]}}, "required": ["target_kind"]}, "then": {"properties": {"target_version": {"const": null}}}},
        {"if": {"properties": {"target_kind": {"enum": ["step", "skill"]}}, "required": ["target_kind"]}, "then": {"properties": {"target_version": {"type": "string", "minLength": 1}}}}
      ]
    },
    "input_inventory": {
      "type": "object",
      "required": ["project", "input_inventory_hash"],
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "input_inventory_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "producer_identity": {"type": ["object", "null"]},
        "schema_identity": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "observation": {
      "type": "object",
      "required": ["observation_id", "task_id", "occurred_at", "target_ref"],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "minLength": 1},
        "target_ref": {"$ref": "#/$defs/target_ref"}
      },
      "additionalProperties": true
    },
    "candidate_record": {
      "type": "object",
      "required": ["candidate_id", "candidate_group_id", "tier", "lifecycle_status", "row_status", "freshness", "evidence_status", "sample_status", "validation_status"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "candidate_group_id": {"type": "string", "minLength": 1},
        "tier": {"enum": ["action_suggested", "reference_only"]},
        "lifecycle_status": {"enum": ["open", "deferred", "verified", "rejected", "superseded"]},
        "row_status": {"enum": ["active", "historical"]},
        "freshness": {"enum": ["current", "stale"]},
        "evidence_status": {"enum": ["complete", "partial", "unknown", "unavailable"]},
        "sample_status": {"enum": ["sufficient", "insufficient_samples"]},
        "validation_status": {"enum": ["verified", "unverified", "not_applicable"]}
      },
      "allOf": [{"if":{"properties":{"classification":{"const":"remove_candidate"}},"required":["classification"]},"then":{"required":["removal_status"],"properties":{"removal_status":{"const":"pending"}}}}],
      "additionalProperties": true
    },
    "candidate_snapshot": {
      "type": "object",
      "required": ["snapshot_id", "publication_generation", "snapshot_content_id"],
      "properties": {
        "snapshot_id": {"type": "string", "minLength": 1},
        "publication_generation": {"type": "integer", "minimum": 1},
        "snapshot_content_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": true
    },
    "batch_begin": {
      "type": "object",
      "required": ["record_kind", "batch_id", "publication_generation"],
      "properties": {"record_kind": {"const": "batch_begin"}, "batch_id": {"type": "string", "minLength": 1}, "publication_generation": {"type": "integer", "minimum": 1}},
      "additionalProperties": true
    },
    "batch_commit": {
      "type": "object",
      "required": ["record_kind", "batch_id", "publication_generation", "status"],
      "properties": {"record_kind": {"const": "batch_commit"}, "batch_id": {"type": "string", "minLength": 1}, "publication_generation": {"type": "integer", "minimum": 1}, "status": {"const": "committed"}, "count": {"type": "integer", "minimum": 0}, "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
      "additionalProperties": true
    },
    "batch_abort": {
      "type": "object",
      "required": ["record_kind", "batch_id", "publication_generation", "reason", "last_committed_prefix_hash", "abandoned_start_offset", "observed_suffix_length", "observed_suffix_hash"],
      "properties": {"record_kind": {"const": "batch_abort"}, "batch_id": {"type": "string", "minLength": 1}, "publication_generation": {"type": "integer", "minimum": 1}, "reason": {"type": "string", "minLength": 1}, "last_committed_prefix_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "abandoned_start_offset": {"type": "integer", "minimum": 0}, "observed_suffix_length": {"type": "integer", "minimum": 0}, "observed_suffix_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
      "additionalProperties": true
    },
    "project_lock": {"type":"object","required":["schema_version","project","attempt_id","owner_token","fencing_token","pid","host_id","boot_id","session_epoch","acquired_monotonic_ms","lease_deadline_monotonic_ms"],"properties":{"schema_version":{"const":"workflow-evolution.v1"},"project":{"type":"string","minLength":1},"attempt_id":{"type":"string","minLength":1},"owner_token":{"type":"string","minLength":1},"fencing_token":{"type":"string","minLength":1},"pid":{"type":"integer","minimum":1},"host_id":{"type":"string","minLength":1},"boot_id":{"type":"string","minLength":1},"session_epoch":{"type":"string","minLength":1},"acquired_monotonic_ms":{"type":"integer","minimum":0},"lease_deadline_monotonic_ms":{"type":"integer","exclusiveMinimum":0}},"additionalProperties":false},
    "manual_recovery": {"type":"object","required":["schema_version","current_lock_sha256","old_boot_id","new_boot_id","operator_identity","issued_at","nonce","confirmation_ref","confirmation_sha256"],"properties":{"schema_version":{"const":"manual-recovery.v1"},"current_lock_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"old_boot_id":{"type":"string","minLength":1},"new_boot_id":{"type":"string","minLength":1},"operator_identity":{"type":"string","minLength":1},"issued_at":{"type":"string","minLength":1},"nonce":{"type":"string","minLength":1},"confirmation_ref":{"type":"string","minLength":1},"confirmation_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false},
    "refresh_result": {
      "type": "object",
      "required": ["record_kind", "project", "attempt_id", "snapshot_content_id", "snapshot_id", "publication_generation", "as_of", "outcome"],
      "properties": {"record_kind": {"const": "refresh_result"}, "project": {"type": "string", "minLength": 1}, "attempt_id": {"type": "string", "minLength": 1}, "snapshot_content_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "snapshot_id": {"type": "string", "minLength": 1}, "publication_generation": {"type": "integer", "minimum": 1}, "as_of": {"type": "string", "minLength": 1}, "outcome": {"enum": ["committed", "failed", "cancelled"]}},
      "additionalProperties": true
    },
    "publication_proof": {
      "type": "object",
      "required": ["schema_version", "record_kind", "batch_id", "project", "attempt_id", "snapshot_content_id", "snapshot_id", "publication_generation", "source_proofs"],
      "properties": {
        "schema_version": {"const": "workflow-evolution.v1"},
        "record_kind": {"const": "publication_proof"},
        "batch_id": {"type": "string", "minLength": 1},
        "project": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "snapshot_content_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "snapshot_id": {"type": "string", "minLength": 1},
        "publication_generation": {"type": "integer", "minimum": 1},
        "source_proofs": {"type": "array"}
      },
      "additionalProperties": false
    },
    "consumer_scan_proof": {
      "type": "object",
      "required": ["schema_version", "project", "task_id", "coverage_status", "zero_consumption", "expected_stage_set", "scanned_stage_set", "scanned_at", "scope_revision", "registered_output_refs", "source_subject", "source_refs", "diagnostics"],
      "properties": {
        "schema_version": {"const": "consumer-scan-proof.v1"},
        "status": {"enum": ["complete", "unknown"]},
        "scope": {"const": "all-current-stage-outcome-files"},
        "stage_count": {"type": "integer", "minimum": 0},
        "outcome_file_count": {"type": "integer", "minimum": 0},
        "subject_count": {"type": "integer", "minimum": 0},
        "project": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "coverage_status": {"enum": ["complete", "partial", "unknown", "unavailable", "stale"]},
        "zero_consumption": {"type": "boolean"},
        "expected_stage_set": {"type": "array", "items": {"enum": ["make-decision", "build-spec", "build-plan", "build-code", "verify-code"]}, "uniqueItems": true},
        "scanned_stage_set": {"type": "array", "items": {"enum": ["make-decision", "build-spec", "build-plan", "build-code", "verify-code"]}, "uniqueItems": true},
        "scanned_at": {"type": "string", "minLength": 1},
        "scope_revision": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "registered_output_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["ref", "source", "consumer_count", "freshness"], "properties": {"ref": {"type": "string", "minLength": 1}, "source": {"type": "object", "required": ["stage", "subject_kind", "subject_id"], "properties": {"stage": {"enum": ["make-decision", "build-spec", "build-plan", "build-code", "verify-code"]}, "subject_kind": {"enum": ["step", "skill"]}, "subject_id": {"type": "string", "minLength": 1}}, "additionalProperties": false}, "consumer_count": {"type": "integer", "minimum": 0}, "freshness": {"enum": ["current", "stale", "unknown", "unavailable"]}}, "additionalProperties": false}},
        "source_subject": {"const": "tools/cli/derive-consumption-edges.mjs"},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^quality/evidence/stage-outcomes/(make-decision|build-spec|build-plan|build-code|verify-code)/[a-f0-9]{64}\\.json$"}},
        "diagnostics": {"type": "array"}
      },
      "additionalProperties": false
    },
    "quality_tax": {"type":"object","required":["sample_count","unknown_count","sample_status","confidence","window_start","window_end","generated_at"],"properties":{"sample_count":{"type":"integer","minimum":0},"unknown_count":{"type":"integer","minimum":0},"sample_status":{"enum":["sufficient","insufficient_samples"]},"confidence":{"enum":["high","medium","low","unavailable"]},"window_start":{"type":"string","minLength":1},"window_end":{"type":"string","minLength":1},"generated_at":{"type":"string","minLength":1}},"additionalProperties":true},
    "attempted_edit": {
      "type":"object",
      "required":["schema_version","record_kind","record_id","edit_record_id","attempt_id","decision_id","decision_ref","decision_sha256","approval","changed_surface","before_facts_ref","before_facts_sha256","before_observed_at","after_facts_ref","after_facts_sha256","after_observed_at","observed_at","validation_method","revert_ref","revert_sha256","outcome","evidence_refs","supersedes","target_ref","ledger_batch_id"],
      "properties":{"schema_version":{"const":"workflow-evolution.v1"},"record_kind":{"const":"attempted-edit"},"record_id":{"type":"string","minLength":1},"edit_record_id":{"type":"string","minLength":1},"attempt_id":{"type":"string","minLength":1},"decision_id":{"type":"string","minLength":1},"decision_ref":{"type":"string","minLength":1},"decision_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"approval":{"const":true},"changed_surface":{"type":"string","minLength":1},"before_facts_ref":{"type":"string","minLength":1},"before_facts_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"before_observed_at":{"type":"string","minLength":1},"after_facts_ref":{"type":"string","minLength":1},"after_facts_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"after_observed_at":{"type":"string","minLength":1},"observed_at":{"type":"string","minLength":1},"validation_method":{"type":"string","minLength":1},"revert_ref":{"type":"string","minLength":1},"revert_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"outcome":{"enum":["improved","unchanged","regressed","inconclusive","reverted"]},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"supersedes":{"type":["string","null"]},"target_ref":{"type":"object"},"ledger_batch_id":{"type":"string","minLength":1}},
      "additionalProperties":false
    },
    "negative_result": {
      "type":"object",
      "required":["schema_version","record_kind","negative_id","attempt_id","attempted_edit_id","attempted_edit_head_sha256","failure_identity","decision_id","decision_ref","decision_sha256","approval","target_ref","failure_domain","failure_kind","observed_at","changed_surface","before_facts_ref","before_facts_sha256","after_facts_ref","after_facts_sha256","validation_method","revert_ref","revert_sha256","status","failure_evidence_refs","supersedes","ledger_batch_id"],
      "properties":{"schema_version":{"const":"workflow-evolution.v1"},"record_kind":{"const":"negative-result"},"negative_id":{"type":"string","minLength":1},"attempt_id":{"type":"string","minLength":1},"attempted_edit_id":{"type":"string","minLength":1},"attempted_edit_head_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"failure_identity":{"type":"string","minLength":1},"decision_id":{"type":"string","minLength":1},"decision_ref":{"type":"string","minLength":1},"decision_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"approval":{"const":true},"target_ref":{"type":"object"},"failure_domain":{"enum":["harness","process","skill_edit"]},"failure_kind":{"enum":["edit_validation_failed","preserve_behavior_regression","workflow_regression","revert_failed"]},"observed_at":{"type":"string","minLength":1},"changed_surface":{"type":"string","minLength":1},"before_facts_ref":{"type":"string","minLength":1},"before_facts_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"after_facts_ref":{"type":"string","minLength":1},"after_facts_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"validation_method":{"type":"string","minLength":1},"revert_ref":{"type":"string","minLength":1},"revert_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"status":{"type":"string","minLength":1},"failure_evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"supersedes":{"type":["string","null"]},"ledger_batch_id":{"type":"string","minLength":1}},
      "additionalProperties":false
    },
    "skill_update_check": {"type":"object","required":["schema_version","status"],"properties":{"schema_version":{"const":"skill-update-check.v1"},"status":{"enum":["available","unavailable","not_checked","stale"]}},"additionalProperties":true},
    "ablation_protocol": {"type":"object","required":["schema_version","protocol_id","candidate_id","decision_id","hypothesis","control_facts_ref","treatment_facts_ref","preserve_behaviors","validation_method","success_oracle","failure_oracle","revert_condition","status","evidence_refs"],"properties":{"schema_version":{"const":"ablation-protocol.v1"},"protocol_id":{"type":"string","minLength":1},"candidate_id":{"type":"string","minLength":1},"decision_id":{"type":"string","minLength":1},"hypothesis":{"type":"string","minLength":1},"control_facts_ref":{"type":"string","minLength":1},"treatment_facts_ref":{"type":"string","minLength":1},"preserve_behaviors":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"validation_method":{"type":"string","minLength":1},"success_oracle":{"type":"string","minLength":1},"failure_oracle":{"type":"string","minLength":1},"revert_condition":{"type":"string","minLength":1},"status":{"enum":["deferred","planned","executed","unavailable"]},"evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}},"additionalProperties":false},
    "brief_section": {"type":"object","required":["section_id","status"],"properties":{"section_id":{"type":"string","minLength":1},"status":{"enum":["ok","empty","unavailable","stale","not_checked"]}},"additionalProperties":true},
    "d24_eval_boundary": {"type":"object","required":["schema_version","dimensions"],"properties":{"schema_version":{"const":"d24-eval-boundary.v1"},"dimensions":{"type":"array","minItems":1,"items":{"type":"string"}}}}
  }
}
