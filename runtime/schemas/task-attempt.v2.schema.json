{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "task_id", "stage", "attempt_id", "created_at", "facts", "evidence_refs", "missing_items", "upstream_refs"],
  "properties": {
    "schema_version": { "const": "task-attempt.v2" },
    "task_id": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["make-decision", "build-spec", "build-plan", "build-code", "verify-code"] },
    "attempt_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "facts": { "type": "object", "properties": {
      "worktree_root": { "type": "string", "pattern": "^/" }, "baseline_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "decision": { "type": "string" }, "scope": { "type": "string" }, "risks": { "type": "array" }, "decision_ref": { "type": "string", "minLength": 1 }, "decision_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "spec_ref": { "type": "string", "minLength": 1 }, "plan_ref": { "type": "string", "minLength": 1 }, "tasks_ref": { "type": "string", "minLength": 1 }, "checkpoint": { "$ref": "#/$defs/checkpointPlan" },
      "changed": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "tests": { "$ref": "#/$defs/tests" }, "review": { "$ref": "#/$defs/review" }, "phase_completion": { "oneOf": [{ "type": "boolean", "deprecated": true, "$comment": "Legacy read-only shape; current TaskKernel publication rejects caller booleans." }, { "$ref": "#/$defs/phaseCompletion" }] },
      "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidenceObject" } }, "quality_note": { "type": "string" }
    }, "dependentRequired": { "decision_ref": ["decision_hash"], "decision_hash": ["decision_ref"] }, "additionalProperties": false },
    "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "missing_items": { "type": "array" },
    "upstream_refs": { "$ref": "#/$defs/refs" },
    "checkpoint": { "$ref": "#/$defs/checkpointPlan" },
    "upstream_acceptances": { "type": "array", "items": { "$ref": "#/$defs/acceptedBinding" } }
  },
  "$defs": {
    "refs": { "type": "array", "items": { "type": "object", "required": ["task_id", "stage", "accepted_ref"], "properties": { "task_id": { "type": "string", "minLength": 1 }, "stage": { "enum": ["make-decision", "build-spec", "build-plan", "build-code", "verify-code"] }, "accepted_ref": { "type": "string", "pattern": "^results/(make-decision|build-spec|build-plan|build-code|verify-code)/accepted\\.json$" } }, "additionalProperties": false } },
    "evidence": { "$ref": "#/$defs/evidenceObject" },
    "evidenceObject": { "type": "object", "required": ["ref", "sha256"], "properties": { "ref": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": false },
    "tests": { "type": "object", "required": ["command", "exit_code", "command_hash", "snapshot_tree", "receipt_ref", "receipt_hash", "output_ref", "output_hash"], "properties": { "command": { "type": "string", "minLength": 1 }, "exit_code": { "type": "integer" }, "command_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "snapshot_tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "receipt_ref": { "type": "string", "minLength": 1 }, "receipt_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "output_ref": { "type": "string", "minLength": 1 }, "output_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": false },
    "review": { "type": "object", "required": ["verdict", "result_ref", "result_hash", "snapshot_tree"], "properties": { "verdict": { "type": "string", "minLength": 1 }, "result_ref": { "type": "string", "pattern": "^reviews/results/" }, "result_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "snapshot_tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" } }, "additionalProperties": false },
    "phaseCompletion": { "type": "object", "required": ["status", "evidence_ref", "evidence_hash", "integration_review", "formal_record_status"], "properties": { "status": { "const": "completed" }, "evidence_ref": { "type": "string", "minLength": 1 }, "evidence_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "integration_review": { "$ref": "#/$defs/evidenceObject" }, "formal_record_status": { "$ref": "#/$defs/formalRecordStatus" } }, "additionalProperties": false },
    "formalRecordStatus": { "type": "object", "required": ["status", "reason"], "properties": { "status": { "enum": ["available", "unavailable"] }, "reason": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "checkpointPlan": { "type": "object", "required": ["schema_version", "stage", "parent_commit", "artifacts", "plan_hash"], "properties": { "schema_version": { "const": "git-checkpoint-plan.v1" }, "stage": { "enum": ["build-spec", "build-plan"] }, "parent_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "plan_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "artifacts": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["path", "blob_oid", "content_hash"], "properties": { "path": { "type": "string", "minLength": 1 }, "blob_oid": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": false } } }, "additionalProperties": false },
    "acceptedBinding": { "type": "object", "required": ["task_id", "stage", "accepted_ref", "integrity_hash"], "properties": { "task_id": { "type": "string", "minLength": 1 }, "stage": { "enum": ["make-decision", "build-spec", "build-plan", "build-code", "verify-code"] }, "accepted_ref": { "type": "string", "pattern": "^results/(make-decision|build-spec|build-plan|build-code|verify-code)/accepted(?:-attempt-[0-9]{4})?\\.json$" }, "integrity_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": false }
  },
  "additionalProperties": true
}
