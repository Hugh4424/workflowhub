{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "browser-qa-evidence.v1",
  "oneOf": [
    { "$ref": "#/$defs/notApplicable" },
    { "$ref": "#/$defs/uiRun" }
  ],
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "revision": { "$ref": "#/$defs/nonEmpty" },
        "instance": { "$ref": "#/$defs/nonEmpty" },
        "contract": { "$ref": "#/$defs/nonEmpty" },
        "ref": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "projectIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_kind", "path", "content_sha256", "revision", "anchor_id", "anchor_title", "anchor_source"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "document_kind": { "$ref": "#/$defs/nonEmpty" },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "revision": { "$ref": "#/$defs/nonEmpty" },
        "anchor_id": { "$ref": "#/$defs/nonEmpty" },
        "anchor_title": { "$ref": "#/$defs/nonEmpty" },
        "anchor_source": { "const": "explicit" },
        "ref": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "cancellation": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "const": "not_cancelled" } } },
        { "type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": { "status": { "const": "cancelled" }, "reason": { "$ref": "#/$defs/nonEmpty" } } }
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "interaction": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "width", "height"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "data_ref": { "$ref": "#/$defs/nonEmpty" },
        "fixture_only": { "type": "boolean" }
      }
    },
    "executionEnvironmentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "revision", "endpoint", "runtime_id"],
      "properties": {
        "kind": { "enum": ["local", "staging", "production"] },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "revision": { "$ref": "#/$defs/nonEmpty" },
        "endpoint": { "$ref": "#/$defs/nonEmpty" },
        "runtime_id": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "executionDataIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "revision", "source", "dataset_id", "fixture_only"],
      "properties": {
        "kind": { "enum": ["seeded", "live", "sanitized"] },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "revision": { "$ref": "#/$defs/nonEmpty" },
        "source": { "$ref": "#/$defs/nonEmpty" },
        "dataset_id": { "$ref": "#/$defs/nonEmpty" },
        "fixture_only": { "const": false }
      }
    },
    "acceptanceScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sample", "scenario", "tier"],
      "properties": {
        "source": { "$ref": "#/$defs/nonEmpty" },
        "sample": { "$ref": "#/$defs/nonEmpty" },
        "scenario": { "$ref": "#/$defs/nonEmpty" },
        "tier": { "const": "browser" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "path": { "$ref": "#/$defs/nonEmpty" },
        "ref": { "$ref": "#/$defs/nonEmpty" }
      },
      "anyOf": [
        { "required": ["path"] },
        { "required": ["ref"] }
      ]
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["observed", "not_observed", "not_applicable"] },
        "reason": { "$ref": "#/$defs/nonEmpty" },
        "screenshot_refs": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["checked", "not_checked", "not_applicable"] },
        "reason": { "$ref": "#/$defs/nonEmpty" },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "notApplicable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "reason"],
      "properties": {
        "applicability": { "const": "not_applicable" },
        "reason": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "uiRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability",
        "result",
        "task_id",
        "stage",
        "attempt_id",
        "invocation_id",
        "material_revision",
        "snapshot_tree",
        "acceptance_criterion_id",
        "route",
        "page",
        "scenario",
        "tool",
        "engine",
        "session",
        "state",
        "viewport",
        "fixture",
        "component",
        "design_revision",
        "design_identity",
        "experience_identity",
        "service_identity",
        "api_identity",
        "dto_identity",
        "browser_profile",
        "cancellation",
        "observations",
        "visual",
        "a11y",
        "auth",
        "performance",
        "screenshots",
        "test",
        "cleanup",
        "engine_switch"
      ],
      "properties": {
        "applicability": { "const": "ui" },
        "result": { "enum": ["pass", "fail", "blocked", "unknown"] },
        "task_id": { "$ref": "#/$defs/nonEmpty" },
        "stage": { "const": "build-code" },
        "attempt_id": { "$ref": "#/$defs/nonEmpty" },
        "invocation_id": { "$ref": "#/$defs/nonEmpty" },
        "material_revision": { "type": "string", "pattern": "^revision-[a-f0-9]{64}$" },
        "snapshot_tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "acceptance_criterion_id": { "$ref": "#/$defs/nonEmpty" },
        "route": { "$ref": "#/$defs/nonEmpty" },
        "page": { "$ref": "#/$defs/nonEmpty" },
        "scenario": { "$ref": "#/$defs/nonEmpty" },
        "acceptance_scenario": { "$ref": "#/$defs/acceptanceScenario" },
        "tool": { "$ref": "#/$defs/nonEmpty" },
        "engine": { "$ref": "#/$defs/nonEmpty" },
        "session": { "$ref": "#/$defs/nonEmpty" },
        "state": { "$ref": "#/$defs/state" },
        "viewport": { "$ref": "#/$defs/viewport" },
        "fixture": { "$ref": "#/$defs/fixture" },
        "component": { "$ref": "#/$defs/component" },
        "design_revision": { "$ref": "#/$defs/nonEmpty" },
        "design_identity": { "$ref": "#/$defs/projectIdentity" },
        "experience_identity": { "$ref": "#/$defs/projectIdentity" },
        "service_identity": { "$ref": "#/$defs/identity" },
        "api_identity": { "$ref": "#/$defs/identity" },
        "dto_identity": { "$ref": "#/$defs/identity" },
        "browser_profile": { "$ref": "#/$defs/identity" },
        "environment_identity": { "$ref": "#/$defs/executionEnvironmentIdentity" },
        "data_identity": { "$ref": "#/$defs/executionDataIdentity" },
        "evidence_ref": { "$ref": "#/$defs/nonEmpty" },
        "evidence_hash": { "$ref": "#/$defs/sha256" },
        "cancellation": { "$ref": "#/$defs/cancellation" },
        "observations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["console", "network", "focus", "overflow"],
          "properties": {
            "console": { "type": "object", "minProperties": 1, "additionalProperties": true },
            "network": { "type": "object", "minProperties": 1, "additionalProperties": true },
            "focus": { "type": "object", "minProperties": 1, "additionalProperties": true },
            "overflow": { "type": "object", "minProperties": 1, "additionalProperties": true }
          }
        },
        "visual": { "$ref": "#/$defs/visual" },
        "a11y": { "$ref": "#/$defs/a11y" },
        "failure_reason": { "$ref": "#/$defs/nonEmpty" },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "login_state_reused"],
          "properties": {
            "mode": { "enum": ["reused", "fresh", "none"] },
            "login_state_reused": { "type": "boolean" }
          }
        },
        "performance": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "metrics"],
              "properties": {
                "status": { "const": "measured" },
                "metrics": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": ["number", "string"]
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "reason"],
              "properties": {
                "status": { "const": "not_measured" },
                "reason": { "$ref": "#/$defs/nonEmpty" }
              }
            }
            ,
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "reason"],
              "properties": {
                "status": { "const": "not_applicable" },
                "reason": { "$ref": "#/$defs/nonEmpty" }
              }
            }
          ]
        },
        "screenshots": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "hash"],
            "properties": {
              "ref": { "$ref": "#/$defs/nonEmpty" },
              "hash": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "test": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "file", "output_ref", "output_hash", "exit_code"],
          "properties": {
            "command": { "$ref": "#/$defs/nonEmpty" },
            "file": { "$ref": "#/$defs/nonEmpty" },
            "output_ref": { "$ref": "#/$defs/nonEmpty" },
            "output_hash": { "$ref": "#/$defs/sha256" },
            "exit_code": { "type": "integer" }
          }
        },
        "cleanup": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "app_service_running"],
              "properties": {
                "status": { "const": "completed" },
                "app_service_running": { "const": true }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "app_service_running", "reason"],
              "properties": {
                "status": { "enum": ["failed", "cancelled"] },
                "app_service_running": { "type": "boolean" },
                "reason": { "$ref": "#/$defs/nonEmpty" }
              }
            }
          ]
        },
        "engine_switch": { "const": "no" }
      },
      "allOf": [
        {
          "if": { "required": ["acceptance_scenario"] },
          "then": {
            "required": ["environment_identity", "data_identity"],
            "properties": {
              "fixture": {
                "required": ["fixture_only"],
                "properties": { "fixture_only": { "const": false } }
              }
            }
          }
        },
        {
          "if": { "properties": { "result": { "const": "pass" } }, "required": ["result"] },
          "then": {
            "properties": {
              "test": { "properties": { "exit_code": { "const": 0 } } },
              "screenshots": { "minItems": 1 },
              "cleanup": { "properties": { "status": { "const": "completed" }, "app_service_running": { "const": true } } }
            }
          }
        },
        {
          "if": { "properties": { "result": { "const": "fail" } }, "required": ["result"] },
          "then": {
            "properties": {
              "test": { "properties": { "exit_code": { "not": { "const": 0 } } } },
              "screenshots": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "result": { "enum": ["blocked", "unknown"] } }, "required": ["result"] },
          "then": {
            "required": ["failure_reason"],
            "properties": { "test": { "properties": { "exit_code": { "not": { "const": 0 } } } } }
          }
        },
        {
          "if": { "properties": { "visual": { "properties": { "status": { "enum": ["not_observed", "not_applicable"] } }, "required": ["status"] } }, "required": ["visual"] },
          "then": { "properties": { "visual": { "required": ["reason"] } } }
        },
        {
          "if": { "properties": { "visual": { "properties": { "status": { "const": "observed" } }, "required": ["status"] } }, "required": ["visual"] },
          "then": { "properties": { "visual": { "required": ["screenshot_refs"], "properties": { "screenshot_refs": { "minItems": 1 } } } } }
        },
        {
          "if": { "properties": { "a11y": { "properties": { "status": { "enum": ["not_checked", "not_applicable"] } }, "required": ["status"] } }, "required": ["a11y"] },
          "then": { "properties": { "a11y": { "required": ["reason"] } } }
        },
        {
          "if": { "properties": { "a11y": { "properties": { "status": { "const": "checked" } }, "required": ["status"] } }, "required": ["a11y"] },
          "then": { "properties": { "a11y": { "required": ["checks"], "properties": { "checks": { "minItems": 1 } } } } }
        },
        {
          "if": { "properties": { "auth": { "properties": { "mode": { "const": "reused" } }, "required": ["mode"] } }, "required": ["auth"] },
          "then": { "properties": { "auth": { "properties": { "login_state_reused": { "const": true } } } } }
        },
        {
          "if": { "properties": { "auth": { "properties": { "mode": { "enum": ["fresh", "none"] } }, "required": ["mode"] } }, "required": ["auth"] },
          "then": { "properties": { "auth": { "properties": { "login_state_reused": { "const": false } } } } }
        }
      ]
    }
  }
}
