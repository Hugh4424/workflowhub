{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "runner-replacement-bootstrap-sealed-bundle.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_name", "task_id", "purpose", "packet", "authorization", "source_diff", "bootstrap_test_receipt", "path_coverage_map", "provider_config"],
  "properties": {
    "schema_version": {"const": "runner-replacement-bootstrap-sealed-bundle.v1"},
    "project_name": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "purpose": {"const": "runner-replacement-bootstrap"},
    "packet": {"$ref": "#/$defs/sealed_record"},
    "authorization": {"$ref": "#/$defs/sealed_record"},
    "source_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["old_runner_oid", "new_runner_oid", "hash", "paths"],
      "properties": {
        "old_runner_oid": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "new_runner_oid": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "bootstrap_test_receipt": {"$ref": "#/$defs/sealed_record"},
    "path_coverage_map": {"$ref": "#/$defs/sealed_record"},
    "provider_config": {"$ref": "#/$defs/sealed_record"}
  },
  "$defs": {
    "sealed_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "hash", "bytes"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "string"}
      }
    }
  }
}
