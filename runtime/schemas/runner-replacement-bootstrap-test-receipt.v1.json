{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "runner-replacement-bootstrap-test-receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_name", "task_id", "commit_oid", "snapshot_tree", "command", "exit_code", "counts", "stdout", "stderr"],
  "properties": {
    "schema_version": {"const": "runner-replacement-bootstrap-test-receipt.v1"},
    "project_name": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "commit_oid": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "snapshot_tree": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "command": {"type": "string", "minLength": 1},
    "exit_code": {"const": 0},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "tests", "passed", "failed"],
      "properties": {
        "files": {"type": "integer", "minimum": 1},
        "tests": {"type": "integer", "minimum": 1},
        "passed": {"type": "integer", "minimum": 1},
        "failed": {"const": 0}
      }
    },
    "stdout": {"$ref": "#/$defs/record"},
    "stderr": {"$ref": "#/$defs/record"}
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "hash"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
