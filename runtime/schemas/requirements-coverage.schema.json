{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflowhub/requirements-coverage.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ledger_hash", "covered", "total", "withdrawn", "missing_ids", "coverage_hash"],
  "properties": {
    "schema_version": { "const": "v1" },
    "ledger_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "covered": { "type": "integer", "minimum": 0 },
    "total": { "type": "integer", "minimum": 0 },
    "withdrawn": { "type": "integer", "minimum": 0 },
    "missing_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "coverage_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
