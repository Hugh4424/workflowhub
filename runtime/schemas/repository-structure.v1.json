{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflowhub.local/runtime/schemas/repository-structure.v1.json",
  "title": "WorkflowHub repository structure",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "directories", "rules"],
  "properties": {
    "schema_version": { "const": "repository-structure.v1" },
    "directories": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "rules": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
