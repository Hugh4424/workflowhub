{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-completion-facts.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result", "objective", "approach", "effect", "verification", "artifacts", "review", "missing_items", "risks", "dependencies", "recovery_conditions", "downstream_read_rule", "next_owner", "user_action"],
  "properties": {
    "schema_version": { "const": "stage-completion-facts.v1" },
    "result": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "approach": { "type": "string", "minLength": 1 },
    "effect": { "type": "string", "minLength": 1 },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conclusion", "limits"],
      "properties": {
        "conclusion": { "type": "string", "minLength": 1 },
        "limits": { "$ref": "#/$defs/stringList" }
      }
    },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "review": { "$ref": "#/$defs/review" },
    "components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
    "confirmation_summary": { "$ref": "#/$defs/confirmationSummary" },
    "source_coverage": { "$ref": "#/$defs/sourceCoverage" },
    "risk_verification": { "type": "array", "items": { "$ref": "#/$defs/riskVerification" } },
    "business_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "code", "tests", "acceptance_criteria"],
      "properties": {
        "content": { "enum": ["present", "not_applicable", "missing"] },
        "code": { "enum": ["complete", "not_applicable", "incomplete"] },
        "tests": { "enum": ["passed", "not_applicable", "failed"] },
        "acceptance_criteria": { "enum": ["covered", "not_applicable", "missing"] }
      }
    },
    "declared_components": { "type": "array", "items": { "$ref": "#/$defs/declaredComponent" } },
    "invocation_facts": { "type": "array", "items": { "$ref": "#/$defs/invocationFact" } },
    "audit_gaps": { "type": "array", "items": { "$ref": "#/$defs/auditGap" } },
    "verification_items": { "type": "array", "items": { "$ref": "#/$defs/verificationItem" } },
    "completion_effect": { "const": "disclose_only" },
    "missing_items": { "$ref": "#/$defs/stringList" },
    "risks": { "$ref": "#/$defs/stringList" },
    "dependencies": { "$ref": "#/$defs/stringList" },
    "recovery_conditions": { "$ref": "#/$defs/stringList" },
    "downstream_read_rule": { "type": "string", "minLength": 1 },
    "next_owner": { "type": "string", "minLength": 1 },
    "user_action": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "result": { "const": "passed" } }, "required": ["result"] },
      "then": { "properties": { "missing_items": { "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "ref": { "type": "object", "additionalProperties": false, "required": ["ref", "hash"], "properties": { "ref": { "type": "string", "minLength": 1 }, "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "declaredComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "stage", "workflow_run_id", "name", "invocation_key", "bundle_hash", "declared_trigger", "invocation"],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "workflow_run_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "invocation_key": { "type": "string", "minLength": 1 },
        "bundle_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "declared_trigger": { "type": "string", "minLength": 1 },
        "invocation": { "enum": ["always", "conditional"] }
      }
    },
    "invocationFact": {
      "type": "object",
      "required": ["task_id", "stage", "workflow_run_id", "name", "invocation_key", "bundle_hash", "declared_trigger", "status"],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "workflow_run_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "invocation_key": { "type": "string", "minLength": 1 },
        "bundle_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "declared_trigger": { "type": "string", "minLength": 1 },
        "status": { "enum": ["executed", "not_invoked", "trigger=false", "unavailable"] },
        "reason": { "type": "string" }
      },
      "additionalProperties": true
    },
    "auditGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "reason"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "verificationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence_refs", "reason"],
      "properties": {
        "id": { "enum": ["current_materials", "diff_scope", "risk_tests", "acceptance_criteria", "tasks_completion", "browser_qa", "independent_review_resolution", "core_gaps", "human_handoff"] },
        "status": { "enum": ["pass", "fail", "unknown", "not_applicable"] },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "ref", "hash", "publication_lookup"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "publication_lookup": { "type": "string", "minLength": 1 }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "reason"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["executed", "trigger=false"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "confirmationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specification", "non_goals", "phases", "dependencies", "tests", "review_advice", "risks", "expected_impact"],
      "properties": {
        "specification": { "type": "string", "minLength": 1 },
        "non_goals": { "$ref": "#/$defs/stringList" },
        "phases": { "$ref": "#/$defs/stringList" },
        "dependencies": { "$ref": "#/$defs/stringList" },
        "tests": { "$ref": "#/$defs/stringList" },
        "review_advice": { "type": "string", "minLength": 1 },
        "risks": { "$ref": "#/$defs/stringList" },
        "expected_impact": { "type": "string", "minLength": 1 }
      }
    },
    "sourceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_keys", "missing_sources", "orphan_sources", "reverse_missing"],
      "properties": {
        "source_keys": { "$ref": "#/$defs/stringList" },
        "missing_sources": { "$ref": "#/$defs/stringList" },
        "orphan_sources": { "$ref": "#/$defs/stringList" },
        "reverse_missing": { "$ref": "#/$defs/stringList" }
      }
    },
    "riskVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_id", "red", "green"],
      "properties": {
        "risk_id": { "type": "string", "minLength": 1 },
        "red": { "type": "object" },
        "green": { "type": "object" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conclusion", "status", "providers", "duration_ms", "tokens", "findings", "refs"],
      "properties": {
        "conclusion": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "providers": { "$ref": "#/$defs/stringList" },
        "duration_ms": { "type": ["number", "null"], "minimum": 0 },
        "tokens": { "type": ["number", "null"], "minimum": 0 },
        "findings": { "type": "array", "items": {} },
        "refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    }
  }
}
