{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality-fact.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fact_id", "task_id", "stage", "material_revision", "snapshot_tree", "kind", "status", "subject", "evidence", "recorded_at"],
  "properties": {
    "schema_version": { "const": "quality-fact.v1" },
    "fact_id": { "type": "string", "pattern": "^quality-[a-f0-9]{64}$" },
    "task_id": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["make-decision", "build-spec", "build-plan", "build-code", "verify-code"] },
    "material_revision": { "type": "string", "pattern": "^revision-[a-f0-9]{64}$" },
    "material_scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "material_scope_revision": { "type": "string", "pattern": "^revision-[a-f0-9]{64}$" },
    "snapshot_tree": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["test", "review", "acceptance_criterion", "confirmation"] },
    "status": { "enum": ["passed", "failed", "unavailable", "missing", "recorded"] },
    "review_status": { "enum": ["clean", "findings", "resolved", "unavailable"] },
    "subject": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "sha256", "evidence_type"],
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "evidence_type": { "type": "string", "minLength": 1 }
        }
      }
    },
    "recorded_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "required": ["material_scope"] },
      "then": { "required": ["material_scope_revision"] }
    },
    {
      "if": { "required": ["material_scope_revision"] },
      "then": { "required": ["material_scope"] }
    },
    {
      "if": {
        "required": ["status"],
        "properties": { "status": { "const": "recorded" } }
      },
      "then": {
        "properties": { "kind": { "const": "review" } }
      }
    }
  ]
}
