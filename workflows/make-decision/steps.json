{
  "schema_version": "2.0.0",
  "stage_slug": "make-decision",
  "steps": [
    { "step_id": 1, "step_slug": "load-context", "order": 1, "entry_conditions": [{ "kind": "portable_skill_package", "uri_or_path": "workflows/make-decision/SKILL.md" }, { "kind": "portable_skill_dependencies", "uri_or_path": "workflows/make-decision/skill-deps.yaml" }, { "kind": "user_requirement", "uri_or_path": "host-visible-requirement" }], "completion_evidence": [{ "kind": "context", "uri_or_path": "host-visible-requirement" }], "observable_result": "The Stage Agent has read the portable package and the user's original requirement.", "depends_on": [] },
    { "step_id": 2, "step_slug": "triage-scope", "order": 2, "entry_conditions": [{ "kind": "context", "uri_or_path": "step://1" }], "completion_evidence": [{ "kind": "decision_log", "uri_or_path": "decision-log.md" }], "observable_result": "The initial scope, uncertainty, and non-goals are written into decision-log.md.", "depends_on": [1] },
    { "step_id": 3, "step_slug": "talk-round-1", "order": 3, "entry_conditions": [{ "kind": "decision_log", "uri_or_path": "step://2" }], "completion_evidence": [{ "kind": "decision_log", "uri_or_path": "decision-log.md" }], "observable_result": "The real problem and material unknowns are clarified with the user and recorded in decision-log.md.", "depends_on": [2] },
    { "step_id": 4, "step_slug": "research-inputs", "order": 4, "entry_conditions": [{ "kind": "decision_log", "uri_or_path": "step://3" }], "completion_evidence": [{ "kind": "decision_log", "uri_or_path": "decision-log.md" }, { "kind": "quality_facts", "uri_or_path": "quality/evidence/" }], "observable_result": "Needed research is completed or honestly marked unavailable or skipped, with conclusions in decision-log.md and source facts under quality/evidence/ when present.", "depends_on": [3] },
    { "step_id": 5, "step_slug": "talk-round-2", "order": 5, "entry_conditions": [{ "kind": "research", "uri_or_path": "step://4" }], "completion_evidence": [{ "kind": "decision_log", "uri_or_path": "decision-log.md" }], "observable_result": "The user-visible choices, consequences, and current direction are recorded in decision-log.md.", "depends_on": [4] },
    { "step_id": 6, "step_slug": "blind-direction-review", "order": 6, "entry_conditions": [{ "kind": "decision_log", "uri_or_path": "step://5" }], "completion_evidence": [{ "kind": "review", "uri_or_path": "quality/reviews/" }], "observable_result": "One independent blind review is recorded as a quality fact; unavailable remains unavailable and does not block same-task work.", "depends_on": [5] },
    { "step_id": 7, "step_slug": "talk-round-3", "order": 7, "entry_conditions": [{ "kind": "review", "uri_or_path": "step://6" }], "completion_evidence": [{ "kind": "decision_log", "uri_or_path": "decision-log.md" }], "observable_result": "Valid blind-review findings and the user's responses are resolved or retained as explicit risks in decision-log.md.", "depends_on": [6] },
    { "step_id": 8, "step_slug": "grill-with-docs", "order": 8, "entry_conditions": [{ "kind": "decision_log", "uri_or_path": "step://7" }], "completion_evidence": [{ "kind": "decision_log", "uri_or_path": "decision-log.md" }, { "kind": "quality_facts", "uri_or_path": "quality/evidence/" }], "observable_result": "The make-decision-only Grill challenges the direction against available documents; conclusions and remaining risks are recorded without creating another state store.", "depends_on": [7] },
    { "step_id": 9, "step_slug": "write-decision-draft", "order": 9, "entry_conditions": [{ "kind": "decision_log", "uri_or_path": "step://8" }], "completion_evidence": [{ "kind": "decision_log", "uri_or_path": "decision-log.md" }], "observable_result": "decision-log.md contains the original requirement, key facts, decision, rationale, risks, and deferred work.", "depends_on": [8] },
    { "step_id": 10, "step_slug": "review-decision-detail", "order": 10, "entry_conditions": [{ "kind": "decision_log", "uri_or_path": "step://9" }], "completion_evidence": [{ "kind": "review", "uri_or_path": "quality/reviews/" }], "observable_result": "One independent detail review is recorded as a quality fact against the current decision-log.md.", "depends_on": [9] },
    { "step_id": 11, "step_slug": "approve-decision", "order": 11, "entry_conditions": [{ "kind": "review", "uri_or_path": "step://10" }], "completion_evidence": [{ "kind": "decision_log", "uri_or_path": "decision-log.md" }], "observable_result": "The user's actual decision is recorded in decision-log.md; no answer is inferred and no confirmation object is created.", "depends_on": [10] },
    { "step_id": 12, "step_slug": "publish-decision", "order": 12, "entry_conditions": [{ "kind": "decision_log", "uri_or_path": "step://11" }], "completion_evidence": [{ "kind": "decision_log", "uri_or_path": "decision-log.md" }, { "kind": "review", "uri_or_path": "quality/reviews/" }], "observable_result": "The Stage Agent gives a plain-language handoff covering what was decided, why, risks, and the next stage; the comment is notification, not a gate.", "depends_on": [11] }
