{
  "schema_version": "2.0.0",
  "stage_slug": "make-decision",
  "steps": [
    { "step_id": 1, "step_slug": "load-context", "order": 1, "entry_conditions": [{ "kind": "portable_skill_package", "uri_or_path": "workflows/make-decision/SKILL.md" }, { "kind": "portable_skill_dependencies", "uri_or_path": "workflows/make-decision/skill-deps.yaml" }, { "kind": "user_requirement", "uri_or_path": "host-visible-requirement" }], "completion_evidence": [{ "kind": "decision_log", "uri_or_path": "decision-log.md" }], "observable_result": "当前会话读取原始需求，先写入唯一任务类型和当前 OI 框架；原始痛点、确认事实、假设、非目标和延期项都保留在同一 decision-log.md。", "depends_on": [] },
    { "step_id": 2, "step_slug": "triage-scope", "order": 2, "entry_conditions": [{ "kind": "decision_log", "uri_or_path": "step://1" }], "completion_evidence": [{ "kind": "decision_log", "uri_or_path": "decision-log.md" }], "observable_result": "先澄清原始痛点和真实需求，再决定是否需要研究与发散；模糊需求写入用户逐字 intake、至少两个角度、初始 OI 和发散触发事实。", "depends_on": [1] },
    { "step_id": 3, "step_slug": "research-and-diverge", "order": 3, "entry_conditions": [{ "kind": "decision_log", "uri_or_path": "step://2" }], "completion_evidence": [{ "kind": "decision_log", "uri_or_path": "decision-log.md" }, { "kind": "research", "uri_or_path": "quality/evidence/research/<sha256>.json" }, { "kind": "quality_facts", "uri_or_path": "quality/facts/" }], "observable_result": "按真实未决问题选择外部与内部研究；研究是发散引擎而不是填空。候选必须带 origin、angle、source、strength、推荐或不推荐理由和全文路径；可证伪大纲超过半数假设被推翻时废弃并以 redraw_of 追加新版本。研究跳过或 unavailable 必须保留真实原因。", "depends_on": [2] },
    { "step_id": 4, "step_slug": "direction-advice", "order": 4, "entry_conditions": [{ "kind": "decision_log", "uri_or_path": "step://3" }], "completion_evidence": [{ "kind": "review", "uri_or_path": "quality/reviews/results/" }, { "kind": "review", "uri_or_path": "quality/reviews/attempts/<attempt_id>/attempt.json" }, { "kind": "decision_log", "uri_or_path": "decision-log.md" }], "observable_result": "异源方向审查看未收敛的候选和 OI questions-only projection，只挑战不替用户选方向；实际 findings、transport、provider 和 unavailable 原因按现有 review writer 保留。", "depends_on": [3] },
    { "step_id": 5, "step_slug": "outline-talk", "order": 5, "entry_conditions": [{ "kind": "review", "uri_or_path": "step://4" }], "completion_evidence": [{ "kind": "decision_log", "uri_or_path": "decision-log.md" }], "observable_result": "方向审查后，主会话用真实 ask -> wait -> 用户 reply -> resume 让用户定大纲方向；每次问题只覆盖一个方向轴，普通项由 agent 记录最小合理假设。", "depends_on": [4] },
    { "step_id": 6, "step_slug": "grill-with-docs", "order": 6, "entry_conditions": [{ "kind": "decision_log", "uri_or_path": "step://5" }], "completion_evidence": [{ "kind": "decision_log", "uri_or_path": "decision-log.md" }], "observable_result": "Grill 对已选大纲与当前事实做一批独立前沿挑战，仍走真实 ask -> wait -> reply -> resume；不调用 wh-review、不创建 review fact，只把最小 decision_updates 追加回 decision-log.md。", "depends_on": [5] },
    { "step_id": 7, "step_slug": "module-convergence", "order": 7, "entry_conditions": [{ "kind": "decision_log", "uri_or_path": "step://6" }], "completion_evidence": [{ "kind": "decision_log", "uri_or_path": "decision-log.md" }], "observable_result": "按当前 OI 和模块台账动态生成问题队列；问题数可以为零、一个或多个，不设固定轮次或最少问题数。每批回答后重排，逐模块记录方案、验收标准、后果、风险、替代方案和普通项假设；选项空间不足时回 research-and-diverge。", "depends_on": [6] },
    { "step_id": 8, "step_slug": "write-decision-draft", "order": 8, "entry_conditions": [{ "kind": "decision_log", "uri_or_path": "step://7" }], "completion_evidence": [{ "kind": "decision_log", "uri_or_path": "decision-log.md" }], "observable_result": "decision-log.md 保留原始声明、派生层、source/hash、三档结论、偏离原因、supersedes 链、风险和延期交接；历史正文只追加不覆盖。", "depends_on": [7] },
    { "step_id": 9, "step_slug": "detail-advice", "order": 9, "entry_conditions": [{ "kind": "decision_log", "uri_or_path": "step://8" }], "completion_evidence": [{ "kind": "review", "uri_or_path": "quality/reviews/results/" }, { "kind": "review", "uri_or_path": "quality/reviews/attempts/<attempt_id>/attempt.json" }, { "kind": "decision_log", "uri_or_path": "decision-log.md" }], "observable_result": "细节审查逐项检查当前 OI terminal fields；它是 advisory，不替代用户确认。若发现方向级或改变验收的争议，标记 conditional Talk；实现级 finding 由主会话处置。", "depends_on": [8] },
    { "step_id": 10, "step_slug": "approve-decision", "order": 10, "entry_conditions": [{ "kind": "review", "uri_or_path": "step://9" }], "completion_evidence": [{ "kind": "decision_log", "uri_or_path": "decision-log.md" }, { "kind": "confirmation", "uri_or_path": "quality/confirmations/" }, { "kind": "quality_facts", "uri_or_path": "quality/facts/" }], "observable_result": "向用户呈现大白话方向卡、范围、非目标、成功条件、风险和延期，并只接受真实 confirmation；不得由 agent 代答或用 review findings 推断同意。", "depends_on": [9] },
    { "step_id": 11, "step_slug": "stage-end-spec-analyze", "order": 11, "entry_conditions": [{ "kind": "confirmation", "uri_or_path": "step://10" }], "completion_evidence": [{ "kind": "decision_log", "uri_or_path": "decision-log.md" }, { "kind": "quality_facts", "uri_or_path": "quality/facts/" }], "observable_result": "现有 spec-analyze 读取原始需求、当前 decision-log、完整 Grill/review facts、确认和真实证据，输出六段 plain-language summary；valid gap 在当前 stage 修复。", "depends_on": [10] },
    { "step_id": 12, "step_slug": "publish-decision", "order": 12, "entry_conditions": [{ "kind": "decision_log", "uri_or_path": "step://11" }], "completion_evidence": [{ "kind": "decision_log", "uri_or_path": "decision-log.md" }, { "kind": "review", "uri_or_path": "quality/reviews/results/" }], "observable_result": "当前会话发布大白话 handoff，说明方向、原因、风险、延期和下游边界；评论是通知，不是第二套状态机或推进门。", "depends_on": [11] },
    { "step_id": 13, "step_slug": "stage-reflection", "order": 13, "entry_conditions": [{ "kind": "decision_log", "uri_or_path": "step://12" }], "completion_evidence": [{ "kind": "stage_reflection", "uri_or_path": "quality/stage-reflection/make-decision/<reflection_key>.json" }], "observable_result": "当前主会话按真实阶段事实执行非阻断复盘；缺 executor 或判断保持 unavailable，不借用旧 outcome。", "depends_on": [12], "on_stage_end": true, "blocking": false }
  ]
