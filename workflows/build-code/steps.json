{
  "schema_version": "1.0.0",
  "stage_slug": "build-code",
  "steps": [
    { "step_id": "read-plan", "order": 1, "entry_conditions": [{ "kind": "plan", "uri_or_path": "plan://approved" }], "completion_evidence": [{ "kind": "input", "uri_or_path": "code://plan-read" }], "observable_result": "Implementation plan is loaded.", "depends_on": [] },
    { "step_id": "write-red-tests", "order": 2, "entry_conditions": [{ "kind": "input", "uri_or_path": "step://read-plan" }], "completion_evidence": [{ "kind": "test", "uri_or_path": "code://red" }], "observable_result": "Failing tests demonstrate the intended change.", "depends_on": ["read-plan"] },
    { "step_id": "implement-change", "order": 3, "entry_conditions": [{ "kind": "test", "uri_or_path": "step://write-red-tests" }], "completion_evidence": [{ "kind": "diff", "uri_or_path": "code://implementation" }], "observable_result": "Scoped implementation is present.", "depends_on": ["write-red-tests"] },
    { "step_id": "run-green-tests", "order": 4, "entry_conditions": [{ "kind": "diff", "uri_or_path": "step://implement-change" }], "completion_evidence": [{ "kind": "test", "uri_or_path": "code://green" }], "observable_result": "Target tests pass.", "depends_on": ["implement-change"] },
    { "step_id": "scan-diff", "order": 5, "entry_conditions": [{ "kind": "test", "uri_or_path": "step://run-green-tests" }], "completion_evidence": [{ "kind": "diff_scan", "uri_or_path": "code://diff-scan" }], "observable_result": "Scope scan is clean.", "depends_on": ["run-green-tests"] },
    { "step_id": "review-change", "order": 6, "entry_conditions": [{ "kind": "diff_scan", "uri_or_path": "step://scan-diff" }], "completion_evidence": [{ "kind": "review", "uri_or_path": "code://review" }], "observable_result": "Independent review passes.", "depends_on": ["scan-diff"] },
    { "step_id": "commit-implementation", "order": 7, "entry_conditions": [{ "kind": "review", "uri_or_path": "step://review-change" }], "completion_evidence": [{ "kind": "commit", "uri_or_path": "git://implementation" }], "observable_result": "Implementation commit exists.", "depends_on": ["review-change"] },
    { "step_id": "publish-code-result", "order": 8, "entry_conditions": [{ "kind": "commit", "uri_or_path": "step://commit-implementation" }], "completion_evidence": [{ "kind": "stage_result", "uri_or_path": "task://stage-result-build-code" }], "observable_result": "Build-code handoff is published.", "depends_on": ["commit-implementation"] }
  ]
}
