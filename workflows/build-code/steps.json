    { "step_id": 6, "step_slug": "run-tests", "order": 6, "entry_conditions": [{ "kind": "skill_invocation", "uri_or_path": "step://5" }], "completion_evidence": [{ "kind": "test", "uri_or_path": "code://test-facts" }], "observable_result": "The selected concrete testing strategy and task oracle are executed; command, result, limits, and snapshot facts are captured.", "depends_on": [5] },
