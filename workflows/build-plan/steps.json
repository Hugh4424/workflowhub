    { "step_id": 9, "step_slug": "review-plan", "order": 9, "entry_conditions": [{ "kind": "analysis", "uri_or_path": "step://8" }], "completion_evidence": [{ "kind": "review", "uri_or_path": "plan://review" }, { "kind": "skill_invocation", "uri_or_path": "skill://wh-review" }], "observable_result": "One independent advisory review covers the frozen plan and tasks.", "depends_on": [8] },
