{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflowhub.local/schemas/execution-trace.schema.json",
  "title": "WorkflowHub Execution Trace Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "session_id",
    "stage",
    "step_id",
    "attempt_id",
    "skill",
    "skill_version",
    "task_id",
    "task_dir",
    "worktree_root",
    "started_at",
    "status",
    "transcript_refs",
    "artifact_refs",
    "facts_refs",
    "provenance",
    "schema_version",
    "collector_version",
    "collector_supported_schema_versions"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1, "description": "Run identity." },
    "session_id": { "type": "string", "minLength": 1, "description": "Session identity containing this execution." },
    "stage": { "type": "string", "minLength": 1, "description": "Workflow stage identity." },
    "step_id": { "type": "string", "minLength": 1, "description": "Step identity within the stage." },
    "attempt_id": { "type": "string", "minLength": 1, "description": "Unique execution attempt identity." },
    "parent_step_id": { "type": ["string", "null"], "description": "Parent step identity when this step is nested." },
    "skill": { "type": "string", "minLength": 1, "description": "Skill used by this execution." },
    "skill_version": { "type": "string", "minLength": 1, "description": "Version of the skill contract used by this execution." },
    "agent_id": { "type": ["string", "null"] },
    "issue_id": { "type": ["string", "null"] },
    "task_id": { "type": "string", "minLength": 1, "description": "Canonical task identity." },
    "task_dir": { "type": "string", "minLength": 1 },
    "target_repo_root": { "type": ["string", "null"] },
    "worktree_root": { "type": "string", "minLength": 1 },
    "branch": { "type": ["string", "null"] },
    "started_at": { "type": "string", "format": "date-time", "description": "Execution start time." },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["pending", "running", "success", "failed", "blocked", "unknown", "skipped"]
    },
    "exit_code": { "type": ["integer", "null"] },
    "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
    "retry_of": { "type": ["string", "null"] },
    "transcript_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/ref" }
    },
    "artifact_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/ref" }
    },
    "facts_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/ref" }
    },
    "provenance": {
      "type": "object",
      "description": "Fact origin. Missing machine evidence must use source_type or confidence unknown, or be explicitly human-declared; it must not be represented as a passing result.",
      "required": ["source_type", "source_ref", "confidence"],
      "additionalProperties": false,
      "properties": {
        "source_type": { "type": "string", "enum": ["machine", "human", "mixed", "unknown"] },
        "source_ref": { "type": ["string", "null"] },
        "confidence": { "type": "string", "enum": ["observed", "declared", "unknown"] }
      }
    },
    "schema_version": { "type": "string", "minLength": 1, "description": "Execution trace contract version. Field, enum, or fact-semantics changes require a schema-version change." },
    "collector_version": { "type": "string", "minLength": 1, "description": "Collector implementation version. Parser bug fixes, collector refactors, and performance improvements change this version without changing schema_version." },
    "collector_supported_schema_versions": {
      "type": "object",
      "description": "Inclusive schema-version range supported by the collector implementation.",
      "required": ["min", "max"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "string", "minLength": 1 },
        "max": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["kind", "ref"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["transcript", "artifact", "facts", "provenance", "human"] },
        "ref": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean", "default": false },
        "note": { "type": ["string", "null"] }
      }
    }
  }
}
