{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bootstrap-review.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_name", "task_id", "purpose", "packet_ref", "packet_hash", "bundle_ref", "bundle_hash", "material_id", "old_runner_oid", "new_runner_oid", "snapshot_tree", "route_descriptor_ref", "route_descriptor_hash", "provider_results", "status", "verdict", "findings", "error"],
  "properties": {
    "schema_version": {"const": "bootstrap-review.v1"},
    "project_name": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "purpose": {"const": "runner-replacement-bootstrap"},
    "packet_ref": {"type": "string", "minLength": 1},
    "packet_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bundle_ref": {"type": "string", "minLength": 1},
    "bundle_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "material_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "old_runner_oid": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "new_runner_oid": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "snapshot_tree": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "route_descriptor_ref": {"type": "string", "minLength": 1},
    "route_descriptor_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provider_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "runtime_id", "session_id", "status", "verdict", "findings", "error"],
        "properties": {
          "provider": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
          "runtime_id": {"type": ["string", "null"]},
          "session_id": {"type": ["string", "null"]},
          "status": {"enum": ["completed", "unavailable", "error"]},
          "verdict": {"enum": ["pass", "revise_required", null]},
          "findings": {"type": "array"},
          "error": {"type": ["object", "null"]}
        }
      }
    },
    "status": {"enum": ["semantic", "unavailable"]},
    "verdict": {"enum": ["pass", "revise_required", null]},
    "findings": {"type": "array"},
    "error": {"type": ["object", "null"]}
  }
}
