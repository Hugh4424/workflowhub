{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "runner-replacement-path-coverage-map.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_name", "task_id", "old_runner_oid", "new_runner_oid", "diff_hash", "entries"],
  "properties": {
    "schema_version": {"const": "runner-replacement-path-coverage-map.v1"},
    "project_name": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "old_runner_oid": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "new_runner_oid": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "diff_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "status"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "status": {"enum": ["covered", "manual_review"]},
          "test_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "manual_focus": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false,
        "oneOf": [
          {"required": ["test_ids"], "not": {"required": ["manual_focus"]}},
          {"required": ["manual_focus"], "not": {"required": ["test_ids"]}}
        ]
      }
    }
  }
}
