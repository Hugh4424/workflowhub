{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan-task-contract.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_ref", "plan_hash", "tasks_ref", "tasks_hash", "phase_rows", "task_rows", "fr_coverage", "ac_coverage", "dependency_validation", "command_oracle_checks", "errors"],
  "properties": {
    "plan_ref": { "type": "string", "minLength": 1 },
    "plan_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "tasks_ref": { "type": "string", "minLength": 1 },
    "tasks_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "phase_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "fields"],
        "properties": {
          "phase": { "type": "string", "minLength": 1 },
          "fields": {
            "type": "object",
            "additionalProperties": false,
            "required": ["Goal", "Files", "Tasks", "Verify", "Knowledge", "STOP"],
            "properties": {
              "Goal": { "type": "string", "minLength": 1 },
              "Files": { "type": "string", "minLength": 1 },
              "Tasks": { "type": "string", "minLength": 1 },
              "Verify": { "type": "string", "minLength": 1 },
              "Knowledge": { "type": "string", "minLength": 1 },
              "STOP": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "task_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "fields", "dependencies", "frs", "acs"],
        "properties": {
          "id": { "type": "string", "pattern": "^T[0-9]+$" },
          "order": { "type": "integer", "minimum": 0 },
          "fields": { "type": "object" },
          "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^T[0-9]+$" } },
          "frs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^FR-(?:[A-Z][A-Z0-9]*-)?[0-9]{3}$" } },
          "acs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^AC-?[0-9]+$" } }
        }
      }
    },
    "fr_coverage": { "$ref": "#/$defs/coverage" },
    "ac_coverage": { "$ref": "#/$defs/coverage" },
    "dependency_validation": { "$ref": "#/$defs/check" },
    "command_oracle_checks": { "$ref": "#/$defs/check" },
    "errors": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted_count", "covered_count", "accepted_ids", "covered_ids"],
      "properties": {
        "accepted_count": { "type": "integer", "minimum": 1 },
        "covered_count": { "type": "integer", "minimum": 0 },
        "accepted_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "covered_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid"],
      "properties": {
        "valid": { "const": true }
      }
    }
  }
}
