{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage-content-evidence.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "task_id", "stage", "workflow_run_id", "producer", "content_hash", "snapshot_head", "snapshot_tree", "created_at", "payload"],
  "properties": {
    "schema_version": { "const": "stage-content-evidence.v1" },
    "kind": { "enum": ["interaction-completion.v1", "ambiguity-ledger.v1", "decision-entry.v1", "decision-coverage-audit.v1", "decision-omission-acceptance.v1", "decision-correction-appendix.v1", "decision-log-contract.v1", "plan-task-contract.v1", "stage-completion-facts.v1", "risk-acceptance.v1"] },
    "task_id": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["make-decision", "build-spec", "build-plan", "build-code", "verify-code"] },
    "workflow_run_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "component", "version"],
      "properties": {
        "stage": { "enum": ["make-decision", "build-spec", "build-plan", "build-code", "verify-code"] },
        "component": { "const": "stage-content-evidence" },
        "version": { "const": "1.0.0" }
      }
    },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "snapshot_head": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "snapshot_tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "previous_ref", "previous_hash"],
      "properties": {
        "number": { "type": "integer", "minimum": 2 },
        "previous_ref": { "type": "string", "minLength": 1 },
        "previous_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "payload": { "type": "object" }
  }
}
