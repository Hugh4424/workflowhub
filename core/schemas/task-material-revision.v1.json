{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-material-revision.v1",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "revision_id",
    "parent_revision",
    "previous_ref",
    "previous_hash",
    "changed_files",
    "change_summary",
    "source_refs",
    "hashes"
  ],
  "properties": {
    "schema_version": { "const": "task-material-revision.v1" },
    "task_id": { "type": "string", "minLength": 1 },
    "revision_id": { "type": "string", "pattern": "^revision-[a-f0-9]{64}$" },
    "parent_revision": {
      "type": ["string", "null"],
      "pattern": "^revision-[a-f0-9]{64}$"
    },
    "previous_ref": {
      "type": ["string", "null"],
      "pattern": "^materials/revisions/[a-f0-9]{64}\\.json$"
    },
    "previous_hash": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "changed_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["decision-log.md", "spec.md", "plan.md", "tasks.md", "requirements"] }
    },
    "change_summary": { "type": "string", "minLength": 1 },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ref", "hash"],
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "hashes": {
      "type": "object",
      "required": ["decision-log.md", "spec.md", "plan.md", "tasks.md"],
      "propertyNames": { "enum": ["decision-log.md", "spec.md", "plan.md", "tasks.md"] },
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger", "coverage"],
      "properties": {
        "ledger": { "$ref": "#/$defs/ref" },
        "coverage": { "$ref": "#/$defs/ref" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "parent_revision": { "type": "null" } } },
      "then": {
        "properties": {
          "previous_ref": { "type": "null" },
          "previous_hash": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "previous_ref": { "type": "string" },
          "previous_hash": { "type": "string" }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "hash"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
