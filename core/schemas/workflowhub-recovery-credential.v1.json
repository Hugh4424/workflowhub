{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "workflowhub-recovery-credential.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_name", "task_id", "recovery_kind", "nonce", "issued_at", "decision", "accepted_business_snapshot"],
  "properties": {
    "schema_version": {"const": "workflowhub-recovery-credential.v1"},
    "project_name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "recovery_kind": {"enum": ["runner-replacement", "phase-pointer"]},
    "nonce": {"type": "string", "minLength": 1, "maxLength": 256},
    "issued_at": {"type": "string", "format": "date-time"},
    "decision": {"const": "accepted"},
    "accepted_business_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["accepted_ref", "accepted_hash", "baseline_commit", "snapshot_tree", "target_repo_root"],
      "properties": {
        "accepted_ref": {"type": "string", "pattern": "^results/make-decision/accepted\\.json$"},
        "accepted_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "baseline_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "snapshot_tree": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "target_repo_root": {"type": "string", "pattern": "^/", "minLength": 1}
      }
    },
    "runner_subject": {"$ref": "#/$defs/runner_subject"},
    "bridge_subject": {"$ref": "#/$defs/bridge_subject"},
    "phase_subject": {"$ref": "#/$defs/phase_subject"}
  },
  "oneOf": [
    {"required": ["runner_subject"], "not": {"required": ["phase_subject"]}},
    {"required": ["phase_subject"], "not": {"required": ["runner_subject"]}}
  ],
  "$defs": {
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["runner_root", "runner_oid", "runner_branch", "project", "task", "stage"],
      "properties": {
        "runner_root": {"type": "string", "minLength": 1},
        "runner_oid": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "runner_branch": {"type": "string", "minLength": 1},
        "project": {"type": "string", "minLength": 1},
        "task": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "agents_ref": {"type": "string", "const": "AGENTS.md"},
        "stage_skill_ref": {"type": "string", "minLength": 1}
      }
    },
    "runner_subject": {
      "type": "object", "additionalProperties": false,
      "required": ["previous_runner", "new_runner", "previous_manifest_hash", "stage"],
      "properties": {
        "previous_runner": {"$ref": "#/$defs/identity"},
        "new_runner": {"$ref": "#/$defs/identity"},
        "previous_manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "stage": {"type": "string", "minLength": 1}
      }
    },
    "bridge_subject": {
      "type": "object", "additionalProperties": false,
      "required": ["current_generation", "current_manifest", "authorization", "bootstrap_packet", "sealed_bundle"],
      "oneOf": [
        {"required": ["bootstrap_review_result"], "not": {"required": ["bootstrap_user_authorization"]}},
        {"required": ["bootstrap_user_authorization"], "not": {"required": ["bootstrap_review_result"]}}
      ],
      "properties": {
        "current_generation": {"$ref": "#/$defs/receipt"},
        "current_manifest": {"$ref": "#/$defs/receipt"},
        "authorization": {
          "type": "object", "additionalProperties": false,
          "required": ["ref", "hash", "excerpt", "excerpt_hash", "source_ref"],
          "properties": {
            "ref": {"type": "string", "minLength": 1},
            "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "excerpt": {"type": "string", "minLength": 1},
            "excerpt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "source_ref": {"type": ["string", "null"]}
          }
        },
        "bootstrap_packet": {"$ref": "#/$defs/receipt"},
        "sealed_bundle": {"$ref": "#/$defs/receipt"},
        "bootstrap_review_result": {"$ref": "#/$defs/receipt"},
        "bootstrap_user_authorization": {"$ref": "#/$defs/receipt"}
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "hash"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "phase_subject": {
      "type": "object", "additionalProperties": false,
      "required": ["current_pointer_ref", "current_pointer_hash", "baseline_phase0_evidence_ref", "baseline_phase0_evidence_hash", "baseline_phase0_review_ref", "baseline_phase0_review_hash", "current_phase_id", "target_phase_id", "baseline_commit", "snapshot_tree", "implementation_receipt", "green_test_receipt", "allowed_files"],
      "properties": {
        "current_pointer_ref": {"const": "phase-result.json"},
        "current_pointer_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "baseline_phase0_evidence_ref": {"type": "string", "minLength": 1},
        "baseline_phase0_evidence_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "baseline_phase0_review_ref": {"type": "string", "minLength": 1},
        "baseline_phase0_review_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "current_phase_id": {"const": "phase-1"},
        "target_phase_id": {"const": "phase-0"},
        "baseline_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "snapshot_tree": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "implementation_receipt": {"$ref": "#/$defs/receipt"},
        "green_test_receipt": {"$ref": "#/$defs/receipt"},
        "red_test_receipt": {"anyOf": [{"$ref": "#/$defs/receipt"}, {"type": "null"}]},
        "allowed_files": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}
