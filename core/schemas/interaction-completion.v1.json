{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interaction-completion.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["interaction_type", "rounds", "grill", "workspace_tree"],
  "properties": {
    "interaction_type": { "enum": ["talk", "grill", "grill-revalidation", "spec-clarify", "aggregate"] },
    "rounds": { "type": "array", "items": { "type": "object" } },
    "grill": { "type": ["object", "null"] },
    "previous_grill": {
      "type": "object",
      "required": ["ref", "hash"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "material_revision": {
      "type": "object",
      "required": ["ref", "hash"],
      "properties": {
        "ref": { "type": "string", "pattern": "^materials/revisions/[a-f0-9]{64}\\.json$" },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "supersedes_revalidation": {
      "type": "object",
      "required": ["ref", "hash"],
      "properties": {
        "ref": { "type": "string", "pattern": "^evidence/stage-content/[a-f0-9]{64}/interaction-completion\\.grill-revalidation-0001\\.json$" },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "workspace_tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "decision_ref": { "type": "string", "minLength": 1 },
    "decision_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "interaction_type": { "const": "aggregate" } },
        "required": ["interaction_type"]
      },
      "then": { "required": ["decision_ref", "decision_hash"] }
    },
    {
      "if": {
        "properties": { "interaction_type": { "const": "grill-revalidation" } },
        "required": ["interaction_type"]
      },
      "then": { "required": ["previous_grill", "material_revision"] }
    },
    {
      "if": {
        "properties": { "interaction_type": { "enum": ["talk", "grill", "grill-revalidation", "spec-clarify"] } },
        "required": ["interaction_type"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["decision_ref"] },
            { "required": ["decision_hash"] }
          ]
        }
      }
    }
  ]
}
