{"nodes": [{"id": "specs_archive_workflowhub_thin_core_card_05_20260919_research_code_diff_baseline_packet_code_diff_baseline_packet", "label": "D-031 Code-Diff Baseline: CARD-02 Bounded Diagnostic Packet", "file_type": "document", "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/code-diff-baseline-packet.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_archive_workflowhub_thin_core_card_05_20260919_research_code_diff_baseline_packet_bounded_single_file_diff", "label": "Freeze minimal bounded corpus: single-file review-record-route.mjs diff", "file_type": "concept", "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/code-diff-baseline-packet.md", "source_location": "L5-L9", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The full CARD-02 range is 128 files / 3.3 MB binary diff, so a single 24,232 B file diff (282 additions / 71 deletions) with pinned OIDs is chosen as the minimal bounded real code-diff corpus, preserving byte counts and SHA-256."}, {"id": "specs_archive_workflowhub_thin_core_card_05_20260919_research_code_diff_baseline_packet_bare_diagnostic_not_authoritative", "label": "Bare diagnostic call is exploratory, never a formal quality baseline", "file_type": "concept", "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/code-diff-baseline-packet.md", "source_location": "L14-L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The single-file bare path only guarantees one real code diff reaches providers: it lacks the full Phase diff, Phase tests/maps and task-bound provenance, may dispatch two providers with a 1,200,000 ms managed wait, writes a non-authoritative sink, and must never be imported into review --action=record or used for the D-011/OI-004 go/no-go."}], "edges": [{"source": "specs_archive_workflowhub_thin_core_card_05_20260919_research_code_diff_baseline_packet_code_diff_baseline_packet", "target": "specs_archive_workflowhub_thin_core_card_05_20260919_research_code_diff_baseline_packet_bounded_single_file_diff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/code-diff-baseline-packet.md", "source_location": "L8", "weight": 1.0}, {"source": "specs_archive_workflowhub_thin_core_card_05_20260919_research_code_diff_baseline_packet_code_diff_baseline_packet", "target": "specs_archive_workflowhub_thin_core_card_05_20260919_research_code_diff_baseline_packet_bare_diagnostic_not_authoritative", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/code-diff-baseline-packet.md", "source_location": "L16", "weight": 1.0}, {"source": "specs_archive_workflowhub_thin_core_card_05_20260919_research_code_diff_baseline_packet_bare_diagnostic_not_authoritative", "target": "specs_archive_workflowhub_thin_core_card_05_20260919_research_card02_merged_review_audit_partial_verdict_pre_vs_post", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/code-diff-baseline-packet.md", "source_location": "L16-L23", "weight": 1.0}], "hyperedges": []}