{"nodes": [{"id": "constitution_f1_thin_core", "label": "F1 Thin core", "file_type": "rationale", "source_file": "CONSTITUTION.md", "source_location": "L12-L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Limits the core to methods and necessary narrow tools so sessions and subagents do work without a stage state machine or forced-progress platform."}, {"id": "constitution_f2_narrow_contract", "label": "F2 Narrow contract", "file_type": "rationale", "source_file": "CONSTITUTION.md", "source_location": "L19-L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Narrow explicit interfaces reduce coupling and let modules be independently understood and replaced."}, {"id": "constitution_f3_current_materials", "label": "F3 Current materials and truthful completion", "file_type": "rationale", "source_file": "CONSTITUTION.md", "source_location": "L26-L31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separates current materials from read-only history and from actual write and completion facts."}, {"id": "constitution_f4_independent_quality", "label": "F4 Independent quality and repair", "file_type": "rationale", "source_file": "CONSTITUTION.md", "source_location": "L33-L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Independent review and human oversight provide quality without making findings a gate that locks repair."}, {"id": "constitution_f6_external_facts", "label": "F6 Unified external facts", "file_type": "rationale", "source_file": "CONSTITUTION.md", "source_location": "L47-L52", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One external fact store and immutable reports prevent duplicate or fabricated progress records."}, {"id": "constitution_f7_human_gates", "label": "F7 Human gates and authorization", "file_type": "rationale", "source_file": "CONSTITUTION.md", "source_location": "L54-L59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Human choices cover direction and plan; continuous task authorization permits necessary delivery, with one final close confirmation."}, {"id": "constitution_f8_simple_first", "label": "F8 Simple first", "file_type": "rationale", "source_file": "CONSTITUTION.md", "source_location": "L61-L66", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefers fewer dependencies and existing consumers over replacement, rebinding, recovery, or second progress platforms."}, {"id": "constitution_f9_falsifiable", "label": "F9 Falsifiable and no fake green", "file_type": "rationale", "source_file": "CONSTITUTION.md", "source_location": "L68-L73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Actual failures and missing data remain visible instead of being converted into a pass by summaries or counts."}, {"id": "constitution_f10_automation_value", "label": "F10 Automation by real value", "file_type": "rationale", "source_file": "CONSTITUTION.md", "source_location": "L75-L80", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automation is added only when its real problem-solving benefit exceeds development and long-term maintenance cost."}, {"id": "constitution_f11_control_plane", "label": "F11 Normal execution and limited control plane", "file_type": "rationale", "source_file": "CONSTITUTION.md", "source_location": "L82-L87", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normal execution is primary; a blocking or persistent control plane requires a proven boundary, owner, consumer, oracle, failure semantics, and exit condition."}, {"id": "constitution_q1_quality_facts", "label": "Q1 Quality facts are not admission gates", "file_type": "rationale", "source_file": "CONSTITUTION.md", "source_location": "L89-L96", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quality facts surface automatically without licensing work, while completion still requires truthful tests, AC judgments, review, and handoff."}, {"id": "constitution_q2_separation", "label": "Q2 Separate basis, writing, and completion", "file_type": "rationale", "source_file": "CONSTITUTION.md", "source_location": "L98-L103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Materials answer what to do, protected I/O and authorization answer how to write, and real results and evidence answer what was completed."}, {"id": "constitution_q3_independent_review", "label": "Q3 Independent review and human oversight", "file_type": "rationale", "source_file": "CONSTITUTION.md", "source_location": "L105-L110", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quality verdicts require an independent source and context; execution identity verifies structure but is not a quality verdict."}, {"id": "constitution_s1_external_reuse", "label": "S1 Reuse external skills", "file_type": "rationale", "source_file": "CONSTITUTION.md", "source_location": "L112-L119", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mature external skills are preferred over rebuilding generic capabilities, while the adopted files remain locally manageable."}, {"id": "constitution_s2_adapt_external_skills", "label": "S2 Adapt external skills constitutionally", "file_type": "rationale", "source_file": "CONSTITUTION.md", "source_location": "L121-L126", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "External skills may be changed locally when needed to fit this project's principles instead of being accepted unchanged."}, {"id": "constitution_s5_subagents", "label": "S5 Subagent-friendly skills", "file_type": "rationale", "source_file": "CONSTITUTION.md", "source_location": "L142-L147", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Custom skills should be callable in independent subagent contexts so the main conversation remains small."}, {"id": "constitution_s7_stage_skill", "label": "S7 One stage, one skill", "file_type": "rationale", "source_file": "CONSTITUTION.md", "source_location": "L156-L161", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One independent skill per stage and one folder per workflow keeps additions isolated and leaves the core unchanged."}, {"id": "constitution_s8_portable_skills", "label": "S8 Portable skills", "file_type": "rationale", "source_file": "CONSTITUTION.md", "source_location": "L163-L168", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skills should be independently callable and portable across hosts and projects rather than bound to one environment."}], "edges": [{"source": "constitution_f1_thin_core", "target": "constitution_f2_narrow_contract", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "CONSTITUTION.md", "source_location": "L12-L24", "weight": 1.0}, {"source": "constitution_f3_current_materials", "target": "constitution_q2_separation", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "CONSTITUTION.md", "source_location": "L26-L31", "weight": 1.0}, {"source": "constitution_f4_independent_quality", "target": "constitution_q3_independent_review", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "CONSTITUTION.md", "source_location": "L33-L38", "weight": 1.0}, {"source": "constitution_f4_independent_quality", "target": "constitution_q1_quality_facts", "relation": "conceptually_related_to", "confidence": "INFERRED", "con