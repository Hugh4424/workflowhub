{"nodes": [{"id": "specs_archive_workflowhub_thin_core_card_05_20260919_research_rf_18_ocr_delegate_packet_recipe_ocr_delegate_packet_recipe", "label": "RF-18 OCR Delegation Packet Adaptation Recipe", "file_type": "document", "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/RF-18-ocr-delegate-packet-recipe.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_archive_workflowhub_thin_core_card_05_20260919_research_rf_18_ocr_delegate_packet_recipe_single_commit_git_materialization", "label": "Packet must be materialized as a single-commit git repository", "file_type": "concept", "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/RF-18-ocr-delegate-packet-recipe.md", "source_location": "L15-L39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OCR delegation mode hard-depends on git; --from <empty-tree> fails (tree vs commit type), so the only viable enumeration is a real single-commit repo, and the commit message is silently injected as review background."}, {"id": "specs_archive_workflowhub_thin_core_card_05_20260919_research_rf_18_ocr_delegate_packet_recipe_no_finding_schema_from_ocr", "label": "OCR delegation mode provides no finding schema", "file_type": "concept", "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/RF-18-ocr-delegate-packet-recipe.md", "source_location": "L98-L103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First-hand measurement overturns the earlier claim that OCR supplies a finding-schema scaffold; the schema must be defined by workflowhub (D-019, LlmComment skeleton plus mandatory evidence)."}, {"id": "specs_archive_workflowhub_thin_core_card_05_20260919_research_rf_18_ocr_delegate_packet_recipe_content_discard_false_closure", "label": "Risk of content-level discard is not dissolved, only relocated to host context", "file_type": "concept", "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/RF-18-ocr-delegate-packet-recipe.md", "source_location": "L105-L117", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Self-correction: OCR no longer reads file contents in delegation mode, but the host sub-agent does, so truncation risk moves to the host context boundary with no OCR warning; D-016's duty to elevate discards to quality facts still applies, at the adaptation layer."}], "edges": [{"source": "specs_archive_workflowhub_thin_core_card_05_20260919_research_rf_18_ocr_delegate_packet_recipe_ocr_delegate_packet_recipe", "target": "specs_archive_workflowhub_thin_core_card_05_20260919_research_rf_18_ocr_delegate_packet_recipe_single_commit_git_materialization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/RF-18-ocr-delegate-packet-recipe.md", "source_location": "L15", "weight": 1.0}, {"source": "specs_archive_workflowhub_thin_core_card_05_20260919_research_rf_18_ocr_delegate_packet_recipe_ocr_delegate_packet_recipe", "target": "specs_archive_workflowhub_thin_core_card_05_20260919_research_rf_18_ocr_delegate_packet_recipe_no_finding_schema_from_ocr", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/RF-18-ocr-delegate-packet-recipe.md", "source_location": "L98", "weight": 1.0}, {"source": "specs_archive_workflowhub_thin_core_card_05_20260919_research_rf_18_ocr_delegate_packet_recipe_ocr_delegate_packet_recipe", "target": "specs_archive_workflowhub_thin_core_card_05_20260919_research_rf_18_ocr_delegate_packet_recipe_content_discard_false_closure", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919