{"nodes": [{"id": "specs_archive_workflowhub_stage_reflection_usability_20260901_decision_log_document", "label": "Decision Log: stage-reflection usability & information quality (accepted)", "file_type": "document", "source_file": "specs/archive/workflowhub-stage-reflection-usability-20260901/decision-log.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_archive_workflowhub_stage_reflection_usability_20260901_decision_log_reflect_command", "label": "D-001 reflect: private CLI command as execution closure", "file_type": "concept", "source_file": "specs/archive/workflowhub-stage-reflection-usability-20260901/decision-log.md", "source_location": "L230-243", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen because every existing mechanism in the repo is 'session executes + CLI records'; a host-injected executor has no production precedent and is unavailable on DSH, while a pure documentation protocol would fork the validator/publish implementation."}, {"id": "specs_archive_workflowhub_stage_reflection_usability_20260901_decision_log_honest_status_enum", "label": "D-002 honest status enum (unavailable / not_scheduled)", "file_type": "concept", "source_file": "specs/archive/workflowhub-stage-reflection-usability-20260901/decision-log.md", "source_location": "L245-258", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'nobody executed', 'never triggered' and 'real failure' are three different facts and must not collapse into one misleading failed status."}, {"id": "specs_archive_workflowhub_stage_reflection_usability_20260901_decision_log_historical_import_20_lessons", "label": "D-003 one-off formal import of 20 historical lessons", "file_type": "concept", "source_file": "specs/archive/workflowhub-stage-reflection-usability-20260901/decision-log.md", "source_location": "L260-273", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User wanted the offline 20-task lessons usable; that conflicts with M16's 'no backfill of historical tasks', so it was granted as a user-approved one-time exception rather than a per-task mechanism."}, {"id": "specs_archive_workflowhub_stage_reflection_usability_20260901_decision_log_fact_projection_trio", "label": "D-004 prompt rewrite + v2 fact-projection trio", "file_type": "concept", "source_file": "specs/archive/workflowhub-stage-reflection-usability-20260901/decision-log.md", "source_location": "L275-288", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prompt-only rewrite stays unverifiable by machine; field-only addition leaves the LLM unsure what to fill, so both legs are required for M16 to aggregate and check."}, {"id": "specs_archive_workflowhub_stage_reflection_usability_20260901_decision_log_schema_version_strategy", "label": "D-005 schema strategy: extend v1 enum in place + new v2 file", "file_type": "concept", "source_file": "specs/archive/workflowhub-stage-reflection-usability-20260901/decision-log.md", "source_location": "L290-309", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enum extension is backward compatible so it stays in v1; the semantic evolution (trio) needs a frozen v1, so it goes to a separate v2 file."}, {"id": "specs_archive_workflowhub_stage_reflection_usability_20260901_decision_log_page_minimal_surface", "label": "D-006 page minimal effective surface", "file_type": "concept", "source_file": "specs/archive/workflowhub-stage-reflection-usability-20260901/decision-log.md", "source_location": "L311-324", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "M16 already touched the monitor page (Evolution trend area), so per the user's instruction that area is frozen; only the vocabulary needed to display the new states truthfully is changed."}, {"id": "specs_archive_workflowhub_stage_reflection_usability_20260901_decision_log_acceptance_definition", "label": "D-007 acceptance: deterministic tests + independent review + minimal real-chain verification", "file_type": "concept", "source_file": "specs/archive/workflowhub-stage-reflection-usability-20260901/decision-log.md", "source_location": "L326-339", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Precedent F-002 showed 130 green tests coexisting with a production-dead reflector, so machine tests alone cannot prove usability; real business-task end-to-end is deferred to DE-001."}, {"id": "specs_archive_workflowhub_stage_reflection_usability_20260901_decision_log_nongoals_boundary", "label": "D-008 non-goals, deferrals and M16 boundary (runner limited to two changes)", "file_type": "concept", "source_file": "specs/archive/workflowhub-stage-reflection-usability-20260901/decision-log.md", "source_location": "L341-353", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_archive_workflowhub_stage_reflection_usability_20260901_decision_log_state_transition_table", "label": "State transition table (condition -> status -> writer)", "file_type": "concept", "source_file": "specs/archive/workflowhub-stage-reflection-usability-20260901/decision-log.md", "source_location": "L249, L408", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_archive_workflowhub_stage_reflection_usability_20260901_decision_log_m16_consumption", "label": "M16 consumer-surface improvement folded into this task", "file_type": "concept", "source_file": "specs/archive/workflowhub-stage-reflection-usability-20260901/decision-log.md", "source_location": "L86, L192", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_archive_workflowhub_stage_reflection_usability_20260901_decision_log_severity_calibration", "label": "Severity calibration rule (occurrence>=2 or user-confirmed -> high)", "file_type": "concept", "source_file": "specs/archive/workflowhub-stage-reflection-usability-20260901/decision-log.md", "source_location": "L264", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_archive_workflowhub_stage_reflection_usability_20260901_decision_log_intervention_extraction", "label": "Human-intervention extraction backfill (20 sessions)", "file_type": "concept", "source_file": "specs/archive/workflowhub-stage-reflection-usability-20260901/decision-log.md", "source_location": "L255", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_archive_workflowhub_stage_reflection_usability_20260901_decision_log_immutable_publication", "label": "Content-addressed immutable publication at fixed path", "file_type": "concept", "source_file": "specs/archive/workflowhub-stage-reflection-usability-20260901/decision-log.md", "source_location": "L237", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same bytes are idempotent, different bytes raise EEXIST; writing a fake failure record would permanently occupy the path, hence run must not publish when no executor exists."}, {"id": "specs_archive_workflowhub_stage_reflection_usability_20260901_decision_log_adr_0023", "label": "ADR 0023 (reflection execution closure, status semantics, constraint revision)", "file_type": "concept", "source_file": "specs/archive/workflowhub-stage-reflection-usability-20260901/decision-log.md", "source_location": "L207", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "specs_archive_workflowhub_stage_reflection_usability_20260901_decision_log_document", "target": "specs_archive_workflowhub_stage_reflection_usability_20260901_decision_log_reflect_command", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/archive/