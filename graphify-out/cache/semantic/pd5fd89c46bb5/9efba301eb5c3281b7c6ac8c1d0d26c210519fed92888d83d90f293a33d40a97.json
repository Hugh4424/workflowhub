{"nodes": [{"id": "specs_archive_workflowhub_thin_core_card_05_20260919_research_sd08_independent_alternative_review_sd08_independent_review", "label": "SD-08 Independent Alternative Review of CARD-05 make-decision Materials", "file_type": "document", "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/SD08-independent-alternative-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_archive_workflowhub_thin_core_card_05_20260919_research_sd08_independent_alternative_review_adr_conflict_timeout_cancel", "label": "Timeout/cancel repair face conflicts with live ADR-0031 ruling", "file_type": "concept", "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/SD08-independent-alternative-review.md", "source_location": "L39-L49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "P5 treats 'timeout does not cancel broker' as a defect, but ADR-0031 forbids cancelling on wall-clock and states that shortening the 20-minute wait would require a new ADR; neither the materials nor the new ADR-0032 acknowledge it."}, {"id": "specs_archive_workflowhub_thin_core_card_05_20260919_research_sd08_independent_alternative_review_session1_misattribution", "label": "S1 zero-dispatch misattributed to initial[] strictness", "file_type": "concept", "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/SD08-independent-alternative-review.md", "source_location": "L51-L60", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The quoted error string has exactly one producer (third-review-host-config.mjs:211) reached only via the host_provider label at :701, before the initial[] loop; the registry already contains 'dsh', so the stated causal chain is wrong."}, {"id": "specs_archive_workflowhub_thin_core_card_05_20260919_research_sd08_independent_alternative_review_integration_not_diff_face", "label": "build-code/integration is not a diff face yet is listed for OCR replacement", "file_type": "concept", "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/SD08-independent-alternative-review.md", "source_location": "L62-L70", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "stage-materials.json sets integration source_bundle='none' with diff keys forbidden, while OCR delegation selects files from git diff; the '3 diff faces' and '3 replaced faces' are different sets, an unregistered conflict."}, {"id": "specs_archive_workflowhub_thin_core_card_05_20260919_research_sd08_independent_alternative_review_ghost_byte_ceiling", "label": "Ghost byte ceiling: 307,200B fail-closed limit already removed", "file_type": "concept", "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/SD08-independent-alternative-review.md", "source_location": "L72-L82", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "D-013's acceptance criterion is vacuously true on the baseline (the constant is gone and two contract tests assert its absence), and the referenced REVIEW_PACKET_MAX_DELIVERY_BYTES constant has no definition anywhere, violating the rule that a check must be able to fail."}, {"id": "specs_archive_workflowhub_thin_core_card_05_20260919_research_sd08_independent_alternative_review_cross_repo_undeclared_writeface", "label": "Cross-repo 3rd-review repair work face left unregistered", "file_type": "concept", "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/SD08-independent-alternative-review.md", "source_location": "L98-L108", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cancel/orphan governance lives in /Users/Hugh/Hugh/Project/3rd-review (broker.mjs, runtime.mjs ttl cleanup) and the materials even cite broker.mjs:577, yet the work face is scoped to this repo with no receiver, interface contract, acceptance criteria or cross-repo authorization."}, {"id": "specs_archive_workflowhub_thin_core_card_05_20260919_research_sd08_independent_alternative_review_any_of_n_globalized", "label": "any-of-N semantics globalized beyond the OCR delegation scope", "file_type": "concept", "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/SD08-independent-alternative-review.md", "source_location": "L118-L122", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The user's any-of-N instruction was limited to OCR delegation-mode review, but D-005/D-017 extend it to 7 document faces still on the old provider chain, degrading multi-source consistency to single-source pass while the independence: partial labeling mechanism (OI-027) remains deferred."}], "edges": [{"source": "specs_archive_workflowhub_thin_core_card_05_20260919_research_sd08_independent_alternative_review_sd08_independent_review", "target": "specs_archive_workflowhub_thin_core_card_05_20260919_research_sd08_independent_alternative_review_adr_conflict_timeout_cancel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/SD08-independent-alternative-review.md", "source_location": "L39", "weight": 1.0}, {"source": "specs_archive_workflowhub_thin_core_card_05_20260919_research_sd08_independent_alternative_review_sd08_independent_review", "target": "specs_archive_workflowhub_thin_core_card_05_20260919_research_sd08_independent_alternative_review_session1_misattribution", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/SD08-independent-alternative-review.md", "source_location": "L51", "weight": 1.0}, {"source": "specs_archive_workflowhub_thin_core_card_05_20260919_research_sd08_independent_alternative_review_sd08_independent_review", "target": "specs_archive_workflowhub_thin_core_card_05_20260919_research_sd08_independent_alternative_review_integration_not_diff_face", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/SD08-independent-alternative-review.md", "source_location": "L62", "weight": 1.0}, {"source": "specs_archive_workflowhub_thin_core_card_05_20260919_research_sd08_independent_alternative_review_sd08_independent_review", "target": "specs_archive_workflowhub_thin_core_card_05_20260919_research_sd08_independent_alternative_review_ghost_byte_ceiling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/SD08-independent-alternative-review.md", "source_location": "L72", "weight": 1.0}, {"source": "specs_archive_workflowhub_thin_core_card_05_20260919_research_sd08_independent_alternative_review_sd08_independent_review", "target": "specs_archive_workflowhub_thin_core_card_05_20260919_research_sd08_independent_alternative_review_cross_repo_undeclared_writeface", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/SD08-independent-alternative-review.md", "source_location": "L98", "weight": 1.0}, {"source": "specs_archive_workflowhub_thin_core_card_05_20260919_research_sd08_independent_alternative_review_sd08_independent_review", "target": "specs_archive_workflowhub_thin_core_card_05_20260919_research_sd08_independent_alternative_review_any_of_n_globalized", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/archive/workflowhub-thin-core-card-05-20260919/research/SD08-independent-alternative-review.md", "source_location": "L118", "weight": 1.0}], "hyperedges": []}