{"nodes": [{"id": "specs_archive_interaction_quality_amendment_v2_spec_interaction_quality_amendment", "label": "Interaction Quality Amendment", "file_type": "concept", "source_file": "specs/archive/interaction-quality-amendment-v2/spec.md", "source_location": "L1-L12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A narrow successor specification focused on interaction quality and decision traceability while preserving the prior handoff, review, close, and platform boundaries."}, {"id": "specs_archive_interaction_quality_amendment_v2_spec_three_round_talk_convergence", "label": "Three-Round Talk Convergence", "file_type": "rationale", "source_file": "specs/archive/interaction-quality-amendment-v2/spec.md", "source_location": "L16-L27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each talk round has a distinct convergence responsibility, dynamically reprioritizes questions after answers, and may stop when facts are sufficient rather than manufacturing questions."}, {"id": "specs_archive_interaction_quality_amendment_v2_spec_plain_language_decision_cards", "label": "Plain-Language Decision Cards", "file_type": "rationale", "source_file": "specs/archive/interaction-quality-amendment-v2/spec.md", "source_location": "L29-L37", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User-facing choices explain meaning, consequences, risks, and a recommendation while keeping separate decision axes out of one compound card."}, {"id": "specs_archive_interaction_quality_amendment_v2_spec_grill_document_judgment", "label": "Grill Document Judgment", "file_type": "rationale", "source_file": "specs/archive/interaction-quality-amendment-v2/spec.md", "source_location": "L39-L51", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Code and documents should answer resolvable questions directly; only remaining load-bearing uncertainty is presented to the user, with CONTEXT, ADR, conflict, and exit-check conclusions recorded."}, {"id": "specs_archive_interaction_quality_amendment_v2_spec_decision_source_chain", "label": "Decision Source Chain", "file_type": "rationale", "source_file": "specs/archive/interaction-quality-amendment-v2/spec.md", "source_location": "L53-L70", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every load-bearing decision records its content, source, constraints, choice, impact, consequences, rejected alternatives, unresolved items, and any supersedes relation."}, {"id": "specs_archive_interaction_quality_amendment_v2_spec_single_axis_spec_clarification", "label": "Single-Axis Spec Clarification", "file_type": "rationale", "source_file": "specs/archive/interaction-quality-amendment-v2/spec.md", "source_location": "L72-L79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spec clarification separates locked decisions, explicit unresolved items, and new ambiguity; it preserves locked wording and asks one dependent decision axis at a time."}, {"id": "specs_archive_interaction_quality_amendment_v2_spec_host_neutral_boundary", "label": "Host-Neutral Boundary", "file_type": "rationale", "source_file": "specs/archive/interaction-quality-amendment-v2/spec.md", "source_location": "L81-L87", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WorkflowHub exposes host-independent interaction and document results, while host-specific mappings remain outside the abstraction and no new runtime, schema, provider, or state machine is added."}, {"id": "specs_archive_interaction_quality_amendment_v2_spec_acceptance_criteria", "label": "Acceptance Criteria AC-001\u2013AC-008", "file_type": "concept", "source_file": "specs/archive/interaction-quality-amendment-v2/spec.md", "source_location": "L90-L116", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_archive_interaction_quality_amendment_v2_spec_non_goals", "label": "Interaction Amendment Non-Goals", "file_type": "concept", "source_file": "specs/archive/interaction-quality-amendment-v2/spec.md", "source_location": "L118-L124", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_archive_interaction_quality_amendment_v2_spec_build_code_lineage", "label": "Build-Code Decision Lineage", "file_type": "rationale", "source_file": "specs/archive/interaction-quality-amendment-v2/spec.md", "source_location": "L67-L70", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The amendment records an approved lineage correction: the host-neutral build-code Skill is authoritative and can be read by different executors without changing implemented behavior."}, {"id": "specs_archive_interaction_quality_amendment_v2_spec_component_dependency_contract", "label": "Component Dependency Contract", "file_type": "concept", "source_file": "specs/archive/interaction-quality-amendment-v2/spec.md", "source_location": "L105-L109", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "specs_archive_interaction_quality_amendment_v2_spec_interaction_quality_amendment", "target": "specs_archive_interaction_quality_amendment_v2_spec_three_round_talk_convergence", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/archive/interaction-quality-amendment-v2/spec.md", "source_location": "L14-L27", "weight": 1.0}, {"source": "specs_archive_interaction_quality_amendment_v2_spec_interaction_quality_amendment", "target": "specs_archive_interaction_quality_amendment_v2_spec_plain_language_decision_cards", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/archive/interaction-quality-amendment-v2/spec.md", "sour