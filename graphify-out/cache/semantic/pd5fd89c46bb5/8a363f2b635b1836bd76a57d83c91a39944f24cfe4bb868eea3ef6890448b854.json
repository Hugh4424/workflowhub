dule", "target": "specs_archive_workflowhub_complexity_governance_v2_plan_writer_cutover", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/archive/workflowhub-complexity-governance-v2/plan.md", "source_location": "L176, L181", "weight": 1.0}, {"source": "specs_archive_workflowhub_complexity_governance_v2_plan_legacy_import_model", "target": "specs_archive_workflowhub_complexity_governance_v2_spec_legacy_import_exit", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/archive/workflowhub-complexity-governance-v2/plan.md", "source_location": "L190, L1301", "weight": 1.0}, {"source": "specs_archive_workflowhub_complexity_governance_v2_plan_test_strategy", "target": "specs_archive_workflowhub_complexity_governance_v2_spec_acceptance_criteria", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/archive/workflowhub-complexity-governance-v2/plan.md", "source_location": "L1304", "weight": 1.0}, {"source": "specs_archive_workflowhub_complexity_governance_v2_plan_test_strategy", "target": "specs_archive_workflowhub_complexity_governance_v2_decision_log_test_convergence", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/archive/workflowhub-complexity-governance-v2/plan.md", "source_location": "L840-847", "weight": 1.0}, {"source": "specs_archive_workflowhub_complexity_governance_v2_plan_three_provider_review", "target": "specs_archive_workflowhub_complexity_governance_v2_plan_test_strategy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/archive/workflowhub-complexity-governance-v2/plan.md", "source_location": "L1256, L1265", "weight": 1.0}, {"source": "specs_archive_workflowhub_complexity_governance_v2_plan_clean_install_verification", "target": "specs_archive_workflowhub_complexity_governance_v2_spec_multica_clean_in