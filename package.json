{
  "name": "workflowhub",
  "version": "0.0.0",
  "private": true,
  "description": "AI 开发工作流编排工具，按设计宪法构建",
  "scripts": {
    "check": "markdownlint-cli2 \"**/*.md\" && node tools/cli/verify-structure.mjs && node tools/cli/run-checks.mjs",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:review": "vitest run tests/review",
    "test:close": "vitest run tests/close",
    "test:left-shift": "vitest run tests/left-shift",
    "test:skills": "vitest run skills",
    "test:core": "vitest run core/__tests__ --exclude=core/__tests__/check-anti-host.test.mjs",
    "test:root": "vitest run tests/*.test.mjs",
    "test:exclusive": "vitest run core/__tests__/check-anti-host.test.mjs --poolOptions.forks.singleFork --no-fileParallelism",
    "test:scripts": "vitest run scripts",
    "test:runtime": "vitest run runtime"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "js-yaml": "4.1.0"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.14.0",
    "vitest": "2.1.9"
  }
}
