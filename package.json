{
  "name": "workflowhub",
  "version": "0.0.0",
  "private": true,
  "description": "AI 开发工作流编排工具，按设计宪法构建",
  "scripts": {
    "check": "markdownlint-cli2 \"**/*.md\" && node tools/cli/verify-structure.mjs && node tools/cli/run-checks.mjs && npm run check:skill-closure && npm run smoke:skill-packages",
    "check:skill-closure": "node runtime/evidence/check-skill-closure.mjs",
    "smoke:skill-packages": "node tools/cli/smoke-local-skill-dispatch.mjs",
    "probe:public-behavior": "WORKFLOWHUB_LIVE_PUBLIC_BEHAVIOR=1 vitest run tests/contract/public-behavior-baseline.test.mjs --poolOptions.forks.singleFork --no-fileParallelism",
    "compare:public-behavior": "node tools/architecture/public-behavior-baseline.mjs compare --baseline=c3e1b1c5b29e5c0aa35beca7718787b4c7a95faf --candidate=worktree",
    "test": "npm run test:safe && npm run test:exclusive",
    "test:profile": "node tools/cli/run-checks.mjs --runtime-profile=phase --evidence-path=${WORKFLOWHUB_PROFILE_EVIDENCE_PATH:-quality/tests/test-profile.json} -- ./node_modules/.bin/vitest run tests/contract/test-runtime-profile.test.mjs tests/contract/runtime-profile-consumer-readback.test.mjs --poolOptions.forks.singleFork --no-fileParallelism",
    "test:safe": "npm run test:contract && npm run test:integration && npm run test:e2e && npm run test:review && npm run test:close && npm run test:left-shift && npm run test:acceptance && npm run test:skills && npm run test:core && npm run test:root",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:review": "vitest run tests/review",
    "test:close": "vitest run tests/close",
    "test:left-shift": "vitest run tests/left-shift",
    "test:acceptance": "node tests/acceptance/build-prd-current.mjs",
    "test:skills": "vitest run skills",
    "test:core": "vitest run core/__tests__ --exclude=core/__tests__/check-extensibility.test.mjs --exclude=core/__tests__/check-anti-host.test.mjs",
    "test:root": "vitest run tests/*.test.mjs scripts specs workflows/build-code/__tests__",
    "test:exclusive": "vitest run core/__tests__/check-extensibility.test.mjs core/__tests__/check-anti-host.test.mjs --poolOptions.forks.singleFork --no-fileParallelism"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "js-yaml": "4.1.0"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.14.0",
    "vitest": "2.1.9"
  }
}
