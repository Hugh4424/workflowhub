{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflowhub.local/schemas/review-bundle.schema.json",
  "type": "object",
  "required": ["schema_version", "skill", "mode", "delivery_mode", "entrypoint", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "skill": { "type": "string", "minLength": 1 },
    "mode": { "const": "lens-only" },
    "delivery_mode": { "enum": ["file_only", "always_embed"] },
    "entrypoint": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" }
    }
  },
  "additionalProperties": false
}
