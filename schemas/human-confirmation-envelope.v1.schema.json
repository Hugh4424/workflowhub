{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://workflowhub.dev/schemas/human-confirmation-envelope.v1.schema.json","type":"object","required":["schema_id","schema_version","purpose","task_id","bound_ref","bound_hash","actor","source_event","authentication","decision","confirmed_at"],"properties":{"schema_id":{"const":"https://workflowhub.dev/schemas/human-confirmation-envelope.v1.schema.json"},"schema_version":{"const":"1.0.0"},"purpose":{"enum":["stage","commit","close","admin-repin","switch"]},"task_id":{"type":"string","minLength":1},"bound_ref":{"type":"string","minLength":1},"bound_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"actor":{"type":"object","required":["id","type"],"properties":{"id":{"type":"string","minLength":1},"type":{"const":"human"}},"additionalProperties":false},"source_event":{"type":"object","required":["ref","sha256","occurred_at"],"properties":{"ref":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"occurred_at":{"type":"string","format":"date-time"}},"additionalProperties":false},"authentication":{"type":"object","required":["method","verified_at","proof_ref","proof_hash"],"properties":{"method":{"enum":["platform-readback","signature"]},"verified_at":{"type":"string","format":"date-time"},"proof_ref":{"type":"string","minLength":1},"proof_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"signature":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"allOf":[{"if":{"properties":{"method":{"const":"signature"}}},"then":{"required":["signature"]}}],"additionalProperties":false},"decision":{"enum":["accepted","rejected","timeout"]},"confirmed_at":{"type":"string","format":"date-time"}},"additionalProperties":false}
