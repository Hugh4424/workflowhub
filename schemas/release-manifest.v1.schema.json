{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://workflowhub.dev/schemas/release-manifest.v1.schema.json","type":"object","required":["schema_id","schema_version","release_version","release_kind","runtime","skills","adapter","lock","contract_set","created_at"],"properties":{"schema_id":{"const":"https://workflowhub.dev/schemas/release-manifest.v1.schema.json"},"schema_version":{"const":"1.0.0"},"release_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"release_kind":{"enum":["preview","final"]},"runtime":{"$ref":"#/$defs/artifact"},"skills":{"type":"array","minItems":6,"maxItems":6,"items":{"$ref":"#/$defs/artifact"}},"adapter":{"$ref":"#/$defs/artifact"},"lock":{"$ref":"#/$defs/artifact"},"contract_set":{"$ref":"#/$defs/artifact"},"created_at":{"type":"string","format":"date-time"}},"$defs":{"artifact":{"type":"object","required":["ref","sha256"],"properties":{"ref":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false}},"additionalProperties":false}
