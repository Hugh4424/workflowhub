{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://workflowhub.dev/schemas/task-accepted.v1.schema.json","type":"object","required":["schema_id","schema_version","task_id","stage","attempt_ref","attempt_hash","acceptance_mode","accepted_at","upstream_refs","snapshot_ref","snapshot_hash"],"properties":{"schema_id":{"const":"https://workflowhub.dev/schemas/task-accepted.v1.schema.json"},"schema_version":{"const":"1.0.0"},"task_id":{"type":"string","minLength":1},"stage":{"enum":["make-decision","build-spec","build-plan","build-code","verify-code"]},"attempt_ref":{"type":"string","pattern":"^results/(make-decision|build-spec|build-plan|build-code|verify-code)/attempt-[0-9]{4}\\.json$"},"attempt_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"acceptance_mode":{"enum":["human","automatic"]},"confirmation_ref":{"type":"string","minLength":1},"accepted_at":{"type":"string","format":"date-time"},"upstream_refs":{"type":"array","items":{"type":"object","required":["ref","sha256"],"properties":{"ref":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false}},"snapshot_ref":{"type":"string","pattern":"^snapshots/[a-f0-9]{64}\\.json$"},"snapshot_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"allOf":[{"if":{"properties":{"acceptance_mode":{"const":"human"}}},"then":{"required":["confirmation_ref"]}},{"if":{"properties":{"acceptance_mode":{"const":"automatic"}}},"then":{"not":{"required":["confirmation_ref"]}}}],"additionalProperties":false}
