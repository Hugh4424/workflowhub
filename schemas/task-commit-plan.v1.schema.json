{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://workflowhub.dev/schemas/task-commit-plan.v1.schema.json","type":"object","required":["schema_id","schema_version","task_id","release_ref","release_hash","lineage_hash","parent_oid","candidate_tree_oid","diff_hash","target_ref","plan_hash"],"properties":{"schema_id":{"const":"https://workflowhub.dev/schemas/task-commit-plan.v1.schema.json"},"schema_version":{"const":"1.0.0"},"task_id":{"type":"string","minLength":1},"release_ref":{"type":"string","minLength":1},"release_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"lineage_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"parent_oid":{"type":"string","pattern":"^[a-f0-9]{40}$"},"candidate_tree_oid":{"type":"string","pattern":"^[a-f0-9]{40}$"},"diff_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"target_ref":{"type":"string","pattern":"^refs/"},"plan_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"additionalProperties":false}
