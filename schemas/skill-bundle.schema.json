{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflowhub.local/schemas/skill-bundle.schema.json",
  "type": "object",
  "required": ["schema_version", "skill", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "skill": { "type": "string", "minLength": 1 },
    "runner_contract_major": { "type": "integer", "minimum": 1 },
    "runner_contract_min_minor": { "type": "integer", "minimum": 0 },
    "runtime_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "source"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": { "oneOf": [
        {
          "type": "object",
          "required": ["url", "commit", "path", "license"],
          "properties": {
            "url": { "type": "string", "pattern": "^https://github\\.com/" },
            "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "path": { "type": "string", "minLength": 1 },
            "license": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "path", "license", "snapshot_sha256", "authorization_basis", "reviewed_at", "review_outcome"],
          "properties": {
            "kind": { "const": "user-provided-local-source" },
            "path": { "type": "string", "minLength": 1 },
            "license": { "type": "string", "minLength": 1 },
            "snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "authorization_basis": { "type": "string", "minLength": 1 },
            "reviewed_at": { "type": "string", "format": "date" },
            "review_outcome": { "enum": ["accepted", "rejected", "watch"] }
          },
          "additionalProperties": false
        }
      ] }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "skill": { "const": "workflowhub" } }, "required": ["skill"] },
      "then": { "required": ["runner_contract_major", "runner_contract_min_minor"] }
    }
  ]
}
