        "fields": [
          "argv",
          "output_ref"
        ],
        "read": "回执只证明跑过的 argv；对照同批必做项，argv 中未出现的项即未做，不新造字段。"
      },
      "失败": {
        "fields": [
          "exit_code",
          "error.code",
          "signal",
          "timed_out",
          "output_ref"
        ],
        "read": "非零 exit_code、error.code、signal 或 timed_out 任一成立即失败；原始失败在 output_ref。"
      },
      "返工半径": {
        "fields": [
          "argv",
          "cwd",
          "output_ref"
        ],
        "read": "按 argv/cwd 圈定命令作用域，失败点回 output_ref 定位；不推广到未跑命令。"
      },
      "下一步": {
        "fields": [
          "exit_code",
          "error",
          "output_ref"
        ],
        "read": "回执只给结果，不给建议；下一步由同批执行说明按 exit_code 与 output_ref 写，不新增字段。"
      }
    }
