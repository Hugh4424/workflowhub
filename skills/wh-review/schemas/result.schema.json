{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wh-review semantic result",
  "type": "object",
  "required": ["version", "task_id", "stage", "review_track", "source", "snapshot_tree", "material_id", "attempt_ref", "provider_results", "verdict", "findings"],
  "properties": {
    "version": { "const": "wh-review-result.v1" },
    "task_id": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["make-decision", "build-spec", "build-plan", "build-code", "verify-code"] },
    "review_track": { "enum": ["direction", "detail", null] },
    "subject_kind": { "enum": ["worktree", "phase"] },
    "phase_id": { "type": ["string", "null"], "minLength": 1 },
    "review_scope": { "enum": ["phase", "integration", null] },
    "base_tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "candidate_tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "source": { "$ref": "attempt.schema.json#/properties/source" },
    "snapshot_tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "material_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "classification_manifest": {
      "type": "object", "required": ["version", "entries"],
      "properties": {
        "version": { "const": "wh-review-classification-manifest.v1" },
        "entries": { "type": "array", "items": {
          "type": "object", "required": ["identity", "category", "sha256"],
          "properties": {
            "identity": { "type": "string", "minLength": 1 },
            "category": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }, "additionalProperties": false
        } }
      }, "additionalProperties": false
    },
    "attempt_ref": { "type": "string", "minLength": 1 },
    "review_chain": {
      "type": "object",
      "required": ["version", "round", "parent_result_ref", "root_result_ref", "prior_snapshot_tree", "current_snapshot_tree", "response_ledger_sha256", "source_diff_sha256"],
      "properties": {
        "version": { "const": "wh-review-chain.v1" },
        "round": { "enum": ["initial", "closure", "full", "legacy"] },
        "parent_result_ref": { "type": ["string", "null"], "pattern": "^reviews/results/[A-Za-z0-9._-]+\\.json$" },
        "root_result_ref": { "type": ["string", "null"], "pattern": "^reviews/results/[A-Za-z0-9._-]+\\.json$" },
        "prior_snapshot_tree": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$" },
        "current_snapshot_tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "response_ledger_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "source_diff_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "report_ref": { "type": "string", "pattern": "^reviews/reports/[A-Za-z0-9._-]+\\.md$" },
    "provider_results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["provider", "output"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "output": {
            "type": "object", "required": ["verdict", "summary", "findings"],
            "properties": {
              "verdict": { "enum": ["pass", "revise_required"] },
              "summary": { "type": "string", "minLength": 1 },
              "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
            },
            "allOf": [{
              "if": { "properties": { "verdict": { "const": "pass" } }, "required": ["verdict"] },
              "then": { "properties": { "findings": { "type": "array", "items": { "allOf": [{ "$ref": "#/$defs/finding" }, { "type": "object", "properties": { "severity": { "const": "minor" } } }] } } } },
              "else": { "properties": { "findings": { "type": "array", "minItems": 1 } } }
            }],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "verdict": { "enum": ["pass", "revise_required"] },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/resultFinding" } },
    "adjudication": {
      "type": "object",
      "required": ["version", "clusters"],
      "properties": {
        "version": { "const": "wh-review-adjudication.v1" },
        "clusters": { "type": "array", "items": { "$ref": "#/$defs/cluster" } }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "finding": {
      "type": "object", "required": ["severity", "path", "issue", "recommendation"],
      "properties": {
        "severity": { "enum": ["blocking", "major", "minor"] }, "path": { "type": "string", "minLength": 1 }, "line": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] }, "issue": { "type": "string", "minLength": 1 }, "recommendation": { "type": "string", "minLength": 1 },
        "root_cause": { "type": "string", "minLength": 1 }, "evidence_kind": { "enum": ["direct", "inferred", "machine"] }, "evidence": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "resultFinding": {
      "type": "object", "required": ["provider", "severity", "path", "issue", "recommendation"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 }, "id": { "type": "string", "pattern": "^F-[a-f0-9]{12}$" }, "severity": { "enum": ["blocking", "major", "minor"] }, "path": { "type": "string", "minLength": 1 }, "line": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] }, "issue": { "type": "string", "minLength": 1 }, "recommendation": { "type": "string", "minLength": 1 },
        "root_cause": { "type": "string", "minLength": 1 }, "providers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "adapter_count": { "type": "integer", "minimum": 1 }, "finding_count": { "type": "integer", "minimum": 1 }, "disposition": { "enum": ["actionable", "nonblocking_minor", "needs_corroboration", "invalid_evidence"] }, "evidence_status": { "enum": ["direct", "corroborated_inference", "minor", "single_inference", "invalid_anchor"] }, "provider_findings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/providerFinding" } }
      },
      "additionalProperties": false
    },
    "providerFinding": {
      "type": "object",
      "required": ["provider", "adapter", "severity", "evidence_kind", "evidence_anchor_valid"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 }, "adapter": { "type": "string", "minLength": 1 }, "severity": { "enum": ["blocking", "major", "minor"] }, "evidence_kind": { "enum": ["direct", "inferred", "machine", "unspecified"] }, "evidence_anchor_valid": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "cluster": {
      "type": "object",
      "required": ["id", "severity", "path", "issue", "root_cause", "recommendation", "providers", "adapter_count", "finding_count", "disposition", "evidence_status", "provider_findings"],
      "properties": {
        "id": { "type": "string", "pattern": "^F-[a-f0-9]{12}$" }, "severity": { "enum": ["blocking", "major", "minor"] }, "path": { "type": "string", "minLength": 1 }, "line": { "type": "integer", "minimum": 1 }, "issue": { "type": "string", "minLength": 1 }, "root_cause": { "type": "string", "minLength": 1 }, "recommendation": { "type": "string", "minLength": 1 }, "providers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "adapter_count": { "type": "integer", "minimum": 1 }, "finding_count": { "type": "integer", "minimum": 1 }, "disposition": { "enum": ["actionable", "nonblocking_minor", "needs_corroboration", "invalid_evidence"] }, "evidence_status": { "enum": ["direct", "corroborated_inference", "minor", "single_inference", "invalid_anchor"] }, "provider_findings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/providerFinding" } }
      },
      "additionalProperties": false
    }
  },
  "allOf": [{
    "if": { "properties": { "review_chain": { "type": "object" } }, "required": ["review_chain"] },
    "then": { "properties": { "review_chain": { "$ref": "#/properties/review_chain" } } }
  }, {
    "if": { "properties": { "review_scope": { "const": "phase" } }, "required": ["review_scope"] },
    "then": { "properties": { "stage": { "const": "build-code" }, "subject_kind": { "const": "phase" } } }
  }, {
    "if": { "properties": { "review_scope": { "const": "integration" } }, "required": ["review_scope"] },
    "then": { "properties": { "stage": { "const": "build-code" }, "subject_kind": { "const": "worktree" }, "phase_id": { "type": "null" } } }
  }, {
    "if": { "properties": { "stage": { "const": "make-decision" } }, "required": ["stage"] },
    "then": { "properties": { "review_track": { "enum": ["direction", "detail"] } } },
    "else": { "properties": { "review_track": { "type": "null" } } }
  }, {
    "if": { "properties": { "subject_kind": { "const": "phase" } }, "required": ["subject_kind"] },
    "then": { "required": ["phase_id", "base_tree", "candidate_tree"], "properties": { "stage": { "const": "build-code" }, "phase_id": { "type": "string", "minLength": 1 } } },
    "else": { "properties": { "phase_id": { "type": "null" } } }
  }, {
    "if": { "properties": { "verdict": { "const": "pass" } }, "required": ["verdict"] },
    "then": {
      "properties": {
        "findings": { "type": "array", "items": { "allOf": [{ "$ref": "#/$defs/resultFinding" }, { "type": "object", "properties": { "severity": { "const": "minor" } } }] } }
      }
    },
    "else": { "properties": { "findings": { "type": "array", "minItems": 1 } } }
  }],
  "additionalProperties": false
}
