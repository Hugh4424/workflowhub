{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wh-review round run result",
  "type": "object",
  "required": ["intent", "round_kind", "baseline_packet_hash", "previous_findings", "closure_evidence", "delta_manifest", "affected_materials", "current_material_manifest", "cross_stage_carryovers", "required_skill_lens_hashes", "provider_outcomes", "merged_findings", "hard_gates", "human_gates", "continuation_eligible", "receipt_draft_ref"],
  "properties": {
    "intent": { "$ref": "review-intent.schema.json" },
    "round_kind": { "enum": ["initial", "continuation"] },
    "baseline_packet_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "previous_findings": { "type": "array" },
    "closure_evidence": { "type": "array" },
    "delta_manifest": { "type": ["object", "null"] },
    "affected_materials": { "type": "object" },
    "current_material_manifest": { "type": "object" },
    "cross_stage_carryovers": { "type": "array" },
    "required_skill_lens_hashes": { "type": "array" },
    "provider_outcomes": { "type": "array" },
    "merged_findings": { "type": "array" },
    "hard_gates": { "type": "array" },
    "human_gates": { "type": "array" },
    "blocked_by_human_confirmation": { "type": "boolean" },
    "continuation_eligible": { "type": "boolean" },
    "receipt_draft_ref": { "type": "string" }
  },
  "additionalProperties": false
}
