{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wh-review dispositions",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "action", "evidence"],
        "properties": {
          "finding_id": { "type": "string", "minLength": 1 },
          "action": { "enum": ["accept", "reject", "defer"] },
          "evidence": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
