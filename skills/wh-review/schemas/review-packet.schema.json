{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review-packet.v1",
  "type": "object",
  "required": ["version", "stage", "review_track", "packet_hash", "manifest_hash", "diff_sha256", "unified_diff", "changed_files", "raw_requirement", "host_verified_facts", "contract_hash", "skill_bundle_hash"],
  "properties": {
    "version": { "const": "review-packet.v1" },
    "stage": { "enum": ["make-decision", "build-spec", "build-plan", "build-code", "verify-code"] },
    "review_track": { "type": ["string", "null"] },
    "packet_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "manifest_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "diff_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "unified_diff": { "type": "string" },
    "changed_files": { "type": "array" },
    "raw_requirement": { "type": "string" },
    "decision_log_excerpt": { "type": "string" },
    "acceptance_design_excerpt": { "type": "string" },
    "planning_artifacts": { "type": "array" },
    "verification_closure": { "type": "array" },
    "test_evidence": { "type": "array" },
    "host_verified_facts": { "type": "array" },
    "contract_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "skill_bundle_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "stage": { "const": "make-decision" }, "review_track": { "const": "direction" } }, "required": ["stage", "review_track"] },
      "then": { "not": { "anyOf": [{ "required": ["decision_log_excerpt"] }, { "required": ["acceptance_design_excerpt"] }, { "required": ["planning_artifacts"] }, { "required": ["verification_closure"] }, { "required": ["test_evidence"] }] } }
    },
    {
      "if": { "properties": { "stage": { "const": "make-decision" }, "review_track": { "const": "detail" } }, "required": ["stage", "review_track"] },
      "then": { "required": ["decision_log_excerpt", "acceptance_design_excerpt"] }
    },
    {
      "if": { "properties": { "stage": { "const": "build-spec" } }, "required": ["stage"] },
      "then": { "required": ["acceptance_design_excerpt", "planning_artifacts"] }
    },
    {
      "if": { "properties": { "stage": { "const": "build-plan" } }, "required": ["stage"] },
      "then": { "required": ["planning_artifacts"] }
    },
    {
      "if": { "properties": { "stage": { "const": "build-code" } }, "required": ["stage"] },
      "then": { "required": ["acceptance_design_excerpt", "test_evidence"] }
    },
    {
      "if": { "properties": { "stage": { "const": "verify-code" } }, "required": ["stage"] },
      "then": { "required": ["acceptance_design_excerpt", "verification_closure", "test_evidence"] }
    }
  ],
  "additionalProperties": false
}
