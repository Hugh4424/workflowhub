{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review-packet.v1",
  "type": "object",
  "required": ["version", "round_kind", "baseline_packet_hash", "stage", "review_track", "packet_hash", "manifest_hash", "diff_sha256", "diff_ref", "changed_files", "raw_requirement", "host_verified_facts", "contract_hash", "skill_bundle_hash", "source_revision"],
  "properties": {
    "version": { "const": "review-packet.v1" },
    "round_kind": { "enum": ["initial", "continuation"] },
    "baseline_packet_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "stage": { "enum": ["make-decision", "build-spec", "build-plan", "build-code", "verify-code"] },
    "review_track": { "enum": ["direction", "detail", null] },
    "packet_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_manifest_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "manifest_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "diff_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "diff_ref": {
      "type": "object",
      "required": ["attachment", "sha256", "size"],
      "properties": {
        "attachment": { "const": "changes.diff" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "status"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.?(/|$)).+$" },
          "old_path": { "type": ["string", "null"], "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.?(/|$)).+$" },
          "status": { "enum": ["added", "modified", "deleted", "renamed"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 0 },
          "old_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "old_size": { "type": "integer", "minimum": 0 }
        },
        "allOf": [
          { "if": { "properties": { "status": { "const": "added" } }, "required": ["status"] }, "then": { "required": ["sha256", "size"] } },
          { "if": { "properties": { "status": { "const": "modified" } }, "required": ["status"] }, "then": { "required": ["sha256", "size", "old_sha256", "old_size"] } },
          { "if": { "properties": { "status": { "const": "deleted" } }, "required": ["status"] }, "then": { "required": ["old_sha256", "old_size"] } },
          { "if": { "properties": { "status": { "const": "renamed" } }, "required": ["status"] }, "then": { "required": ["path", "old_path", "sha256", "size", "old_sha256", "old_size"], "properties": { "old_path": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.?(/|$)).+$" } } } }
        ],
        "additionalProperties": false
      }
    },
    "raw_requirement": { "type": "string" },
    "decision_log_excerpt": { "type": "string" },
    "acceptance_design_excerpt": { "type": "string" },
    "acceptance_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ac_id", "status", "evidence"],
        "properties": {
          "ac_id": { "type": "string", "pattern": "^AC-[0-9]+$" },
          "status": { "enum": ["covered", "partial", "not_covered"] },
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["kind", "name", "result", "object"],
              "properties": {
                "kind": { "enum": ["test", "code", "trace", "report"] },
                "name": { "type": "string", "minLength": 1 },
                "result": { "type": "string", "minLength": 1 },
                "object": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "planning_artifacts": { "type": "array" },
    "verification_closure": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "state", "evidence"],
        "properties": {
          "subject": { "type": "string", "minLength": 1 },
          "state": { "enum": ["closed", "open", "accepted_exception"] },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": true
      }
    },
    "test_evidence": { "type": "array" },
    "host_verified_facts": { "type": "array" },
    "review_lenses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill", "bundle_hash", "checked_objects"],
        "properties": {
          "skill": { "type": "string", "minLength": 1 },
          "bundle_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "checked_objects": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "contract_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "skill_bundle_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "redactions_applied": {
      "type": "object",
      "required": ["version", "count", "categories"],
      "properties": {
        "version": { "const": 1 },
        "count": { "type": "integer", "minimum": 1 },
        "categories": {
          "type": "object",
          "required": ["absolute_path"],
          "properties": { "absolute_path": { "type": "integer", "minimum": 1 } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
    ,"source_revision": {
      "type": "object",
      "properties": {
        "base_tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "snapshot_tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "captured_head": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" }
      },
      "required": ["base_tree", "snapshot_tree", "captured_head"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "stage": { "const": "make-decision" } }, "required": ["stage"] },
      "then": { "properties": { "review_track": { "enum": ["direction", "detail"] } } },
      "else": { "properties": { "review_track": { "type": "null" } } }
    },
    {
      "if": { "properties": { "round_kind": { "const": "initial" } }, "required": ["round_kind"] },
      "then": { "properties": { "baseline_packet_hash": { "type": "null" } } },
      "else": { "properties": { "baseline_packet_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
    },
    {
      "if": { "properties": { "stage": { "const": "make-decision" }, "review_track": { "const": "direction" } }, "required": ["stage", "review_track"] },
      "then": { "not": { "anyOf": [{ "required": ["decision_log_excerpt"] }, { "required": ["acceptance_design_excerpt"] }, { "required": ["acceptance_evidence"] }, { "required": ["planning_artifacts"] }, { "required": ["verification_closure"] }, { "required": ["test_evidence"] }] } }
    },
    {
      "if": { "properties": { "stage": { "const": "make-decision" }, "review_track": { "const": "detail" } }, "required": ["stage", "review_track"] },
      "then": { "required": ["decision_log_excerpt", "acceptance_design_excerpt"] }
    },
    {
      "if": { "properties": { "stage": { "const": "build-spec" } }, "required": ["stage"] },
      "then": { "required": ["acceptance_design_excerpt", "planning_artifacts"] }
    },
    {
      "if": { "properties": { "stage": { "const": "build-plan" } }, "required": ["stage"] },
      "then": { "required": ["planning_artifacts"] }
    },
    {
      "if": { "properties": { "stage": { "const": "build-code" } }, "required": ["stage"] },
      "then": { "required": ["acceptance_design_excerpt", "test_evidence"] }
    },
    {
      "if": { "properties": { "stage": { "const": "verify-code" } }, "required": ["stage"] },
      "then": {
        "required": ["acceptance_design_excerpt", "acceptance_evidence", "verification_closure", "test_evidence", "review_lenses"],
        "properties": {
          "acceptance_evidence": { "type": "array", "minItems": 1 },
          "verification_closure": { "type": "array", "minItems": 1 },
          "review_lenses": { "type": "array", "minItems": 1 }
        }
      }
    }
  ],
  "additionalProperties": false
}
