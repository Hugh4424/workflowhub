{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wh-review non-gate response record",
  "type": "object",
  "required": ["version", "task_id", "stage", "review_track", "outcome", "previous_result_ref", "previous_result_sha256", "previous_snapshot_tree", "snapshot_tree", "evidence_state", "response_ledger", "response_ledger_sha256", "unverified_reason", "accepted_risk_count"],
  "properties": {
    "version": { "const": "wh-review-resolution.v1" },
    "task_id": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["build-spec", "build-plan", "verify-code"] },
    "review_track": { "type": "null" },
    "outcome": { "const": "recorded_non_gate_response" },
    "previous_result_ref": { "type": "string", "pattern": "^reviews/results/[A-Za-z0-9._-]+\\.json$" },
    "previous_result_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "previous_snapshot_tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "snapshot_tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "evidence_state": { "enum": ["verified", "unverified"] },
    "response_ledger": { "type": ["object", "null"] },
    "response_ledger_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "unverified_reason": { "type": ["string", "null"], "minLength": 1 },
    "accepted_risk_count": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
