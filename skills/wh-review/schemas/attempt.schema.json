{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wh-review attempt",
  "type": "object",
  "required": ["version", "attempt_id", "task_id", "stage", "review_track", "source", "snapshot_tree", "material_id", "provider_attempts", "terminal_status", "error"],
          "properties": {
    "version": { "const": "wh-review-attempt.v1" },
    "attempt_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["make-decision", "build-spec", "build-plan", "build-code", "verify-code"] },
    "review_track": { "enum": ["direction", "detail", null] },
    "subject_kind": { "enum": ["worktree", "phase"] },
    "phase_id": { "type": ["string", "null"], "minLength": 1 },
    "base_tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "candidate_tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "phase_evidence": { "type": "object", "required": ["subject_ref", "subject_hash", "diff_ref", "diff_hash"], "properties": { "subject_ref": { "type": "string", "pattern": "^evidence/phases/" }, "subject_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "diff_ref": { "type": "string", "pattern": "^evidence/phases/" }, "diff_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": false },
    "source": { "oneOf": [
      { "type": "object", "required": ["target_commit", "base_commit", "base_tree", "captured_head"], "properties": { "target_commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" }, "base_commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" }, "base_tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" }, "captured_head": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" } }, "additionalProperties": false },
      { "type": "object", "required": ["baseline_tree", "implementation_tree"], "properties": { "baseline_tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" }, "implementation_tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" } }, "additionalProperties": false }
    ] },
    "snapshot_tree": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "material_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provider_attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provider", "status", "session_id", "runtime_id", "output_ref", "error"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "status": { "enum": ["completed", "failed", "cancelled"] },
          "session_id": { "type": ["string", "null"] },
          "runtime_id": { "type": ["string", "null"] },
          "output_ref": { "type": ["string", "null"] },
          "error": {
            "oneOf": [
              { "type": "null" },
              { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 } }, "additionalProperties": false }
            ]
          }
        },
        "allOf": [{
          "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
          "then": { "properties": { "error": { "type": "null" } } },
          "else": { "properties": { "error": { "type": "object" } } }
        }],
        "additionalProperties": false
      }
    },
    "terminal_status": { "enum": ["semantic", "unavailable"] },
    "error": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 } }, "additionalProperties": false }
      ]
    }
  },
  "allOf": [{
    "if": { "properties": { "stage": { "const": "make-decision" } }, "required": ["stage"] },
    "then": { "properties": { "review_track": { "enum": ["direction", "detail"] } } },
    "else": { "properties": { "review_track": { "type": "null" } } }
  }, {
    "if": { "properties": { "subject_kind": { "const": "phase" } }, "required": ["subject_kind"] },
    "then": { "required": ["phase_id", "base_tree", "candidate_tree"], "properties": { "stage": { "const": "build-code" }, "phase_id": { "type": "string", "minLength": 1 } } },
    "else": { "properties": { "phase_id": { "type": "null" } } }
  }, {
    "if": { "properties": { "terminal_status": { "const": "semantic" } }, "required": ["terminal_status"] },
    "then": { "properties": { "error": { "type": "null" } } },
    "else": { "properties": { "error": { "type": "object" } } }
  }],
  "additionalProperties": false
}
