{
  "schema_version": 1,
  "name": "wh-review",
  "commands": {
    "run": "scripts/wh-review-cli.mjs run",
    "format-correct": "scripts/wh-review-cli.mjs format-correct",
    "verify-final": "scripts/wh-review-cli.mjs verify-final",
    "doctor": "scripts/wh-review-cli.mjs doctor"
  },
  "runtime_review": {
    "stage_materials": "runtime/review/stage-materials.json",
    "schemas": {
      "attempt": "runtime/review/schemas/attempt.schema.json",
      "result": "runtime/review/schemas/result.schema.json",
      "stage_materials": "runtime/review/schemas/stage-materials.schema.json",
      "ac_evidence_summary": "runtime/review/schemas/ac-evidence-summary.schema.json"
    }
  },
  "stage_skill_plan": "stage-skill-plan.json",
  "provider_result_contract": "contracts/workflowhub-result.v2.json",
  "contracts": {
    "make-decision": {
      "path": "contracts/make-decision.md",
      "review_tracks": ["direction", "detail"],
      "required_skills_by_track": {
        "direction": ["intake-decision-review", "plan-ceo-review", "review"],
        "detail": ["simplicity-guard", "plan-ceo-review", "review"]
      }
    },
    "build-spec": {
      "path": "contracts/build-spec.md",
      "required_skills": ["simplicity-guard", "plan-ceo-review", "review"],
      "optional_skills": [{ "name": "plan-design-review", "when": "ui" }]
    },
    "build-plan": {
      "path": "contracts/build-plan.md",
      "required_skills": [
        "simplicity-guard",
        "spec-analyze",
        "plan-eng-review",
        "review"
      ],
      "required_materials_by_skill": {
        "plan-eng-review": [
          "approved_spec",
          "draft_plan",
          "draft_tasks",
          "plan_task_contract"
        ]
      }
    },
    "build-code": {
      "path": "contracts/build-code.md",
      "required_skills": ["simplicity-guard", "review"]
    },
    "verify-code": {
      "path": "contracts/verify-code.md",
      "required_skills": ["qa-only", "verify-change"]
    }
  }
}
