{
  "schema_version": 1,
  "name": "wh-review",
  "commands": {
    "run": "scripts/wh-review-cli.mjs run",
    "verify-final": "scripts/wh-review-cli.mjs verify-final"
  },
  "stage_materials": "stage-materials.json",
  "stage_skill_plan": "stage-skill-plan.json",
  "schemas": {
    "attempt": "schemas/attempt.schema.json",
    "result": "schemas/result.schema.json",
    "stage_materials": "schemas/stage-materials.schema.json"
  },
  "provider_result_contract": "contracts/workflowhub-result.v1.json",
  "contracts": {
    "make-decision": {
      "path": "contracts/make-decision.md",
      "review_tracks": ["direction", "detail"]
    },
    "build-spec": {
      "path": "contracts/build-spec.md",
      "required_skills": ["plan-ceo-review", "review"],
      "optional_skills": [{ "name": "plan-design-review", "when": "ui" }]
    },
    "build-plan": {
      "path": "contracts/build-plan.md",
      "required_skills": [
        "spec-analyze",
        "plan-eng-review",
        "review"
      ]
    },
    "build-code": {
      "path": "contracts/build-code.md",
      "required_skills": []
    },
    "verify-code": {
      "path": "contracts/verify-code.md",
      "required_skills": ["qa-only", "verify-change"],
      "optional_skills": [{ "name": "isolated-browser-qa", "when": "ui" }]
    }
  }
}
