{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "3rd-review public WorkflowHub result v1",
  "type": "object",
  "required": ["result_protocol", "provider", "status", "material_id", "session_id", "output", "error"],
  "properties": {
    "result_protocol": { "const": "workflowhub-result.v1" },
    "provider": { "type": "string", "minLength": 1 },
    "status": { "enum": ["completed", "failed", "cancelled"] },
    "material_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "session_id": { "type": ["string", "null"] },
    "output": { "type": ["string", "null"] },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": true
}
