{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkflowHub public result v3",
  "type": "object",
  "required": ["version", "host_provider", "material_id", "outcome", "providers", "round", "runtime_id", "selected_tier"],
  "properties": {
    "version": { "const": "workflowhub-result.v3" },
    "host_provider": { "type": "string", "minLength": 1 },
    "material_id": { "type": "string", "minLength": 1 },
    "outcome": { "enum": ["completed", "partial", "unavailable", "cancelled"] },
    "providers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/member" } },
    "round": { "type": "integer", "minimum": 1 },
    "runtime_id": { "type": "string", "minLength": 1 },
    "selected_tier": { "type": ["integer", "null"], "minimum": 0 },
    "initial_result_ref": { "type": ["string", "null"], "minLength": 1 },
    "publication": { "$ref": "#/$defs/publication" },
    "supplements": { "type": "array", "items": { "$ref": "#/$defs/supplement" } }
  },
  "additionalProperties": false,
  "$defs": {
    "error": {
      "type": ["object", "null"],
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "required": ["attempts", "continuable", "deadline_ms", "error", "identity", "material", "output", "provenance", "recovery", "result_protocol", "session_id", "status", "timing", "usage"],
      "properties": {
        "attempts": { "type": "array", "items": { "$ref": "#/$defs/attempt" } },
        "continuable": { "type": "boolean" },
        "deadline_ms": { "type": ["integer", "null"], "minimum": 1 },
        "error": { "$ref": "#/$defs/error" },
        "identity": {
          "type": "object",
          "required": ["adapter", "config_id", "model", "provider", "source_id"],
          "properties": {
            "adapter": { "type": "string", "minLength": 1 },
            "config_id": { "type": "string", "minLength": 1 },
            "model": { "type": ["string", "null"] },
            "provider": { "type": "string", "minLength": 1 },
            "source_id": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "material": {
          "type": "object",
          "required": ["contract_hash", "contract_id", "material_id", "semantic_hash"],
          "properties": {
            "contract_hash": { "type": "string", "minLength": 1 },
            "contract_id": { "type": "string", "minLength": 1 },
            "material_id": { "type": "string", "minLength": 1 },
            "semantic_hash": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "output": { "type": ["string", "null"] },
        "provenance": {
          "type": "object",
          "required": ["raw_output_sha256", "raw_stderr_sha256", "runtime_id"],
          "properties": {
            "raw_output_sha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" },
            "raw_stderr_sha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" },
            "runtime_id": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "recovery": {
          "type": "object",
          "required": ["fresh_execution_retry_count", "provider_internal_retry_count", "same_session_repair_count"],
          "properties": {
            "fresh_execution_retry_count": { "type": "integer", "minimum": 0 },
            "provider_internal_retry_count": { "type": "integer", "minimum": 0 },
            "same_session_repair_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "result_protocol": { "const": "workflowhub-result.v3" },
        "session_id": { "type": ["string", "null"], "minLength": 1 },
        "status": { "enum": ["running", "completed", "failed", "cancelled"] },
        "timing": {
          "type": "object",
          "required": ["completed_at_ms", "duration_ms", "started_at_ms"],
          "properties": {
            "completed_at_ms": { "type": ["integer", "null"], "minimum": 0 },
            "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
            "started_at_ms": { "type": ["integer", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        "usage": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/usage" }] }
      },
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "required": ["attempt_id", "completed_at_ms", "duration_ms", "error", "kind", "provider_retry_count", "session_id", "started_at_ms", "status"],
      "properties": {
        "attempt_id": { "type": "string", "minLength": 1 },
        "completed_at_ms": { "type": ["integer", "null"], "minimum": 0 },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "error": { "$ref": "#/$defs/error" },
        "kind": { "type": "string", "minLength": 1 },
        "provider_retry_count": { "type": "integer", "minimum": 0 },
        "session_id": { "type": ["string", "null"], "minLength": 1 },
        "started_at_ms": { "type": ["integer", "null"], "minimum": 0 },
        "status": { "enum": ["running", "completed", "failed", "cancelled"] }
      },
      "additionalProperties": false
    },
    "usage_value": {
      "anyOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/usage_value" } }
      ]
    },
    "cost_usage_value": {
      "anyOf": [
        { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
        { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/cost_usage_value" } }
      ]
    },
    "usage": {
      "type": "object",
      "minProperties": 1,
      "properties": { "cost": { "$ref": "#/$defs/cost_usage_value" } },
      "additionalProperties": { "$ref": "#/$defs/usage_value" }
    },
    "publication": {
      "type": "object",
      "required": ["append_window", "published_at", "published_at_least_sources", "running_member_count", "status"],
      "properties": {
        "status": { "enum": ["not_published", "initial_published", "late_open", "late_closed"] },
        "published_at": { "type": ["integer", "null"], "minimum": 0 },
        "published_at_least_sources": { "type": "integer", "minimum": 0 },
        "running_member_count": { "type": "integer", "minimum": 0 },
        "append_window": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["duration_ms", "ends_at", "starts_at"],
              "properties": {
                "starts_at": { "type": "integer", "minimum": 0 },
                "ends_at": { "type": "integer", "minimum": 0 },
                "duration_ms": { "const": 600000 }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "supplement": {
      "type": "object",
      "required": ["arrival_at", "arrival_elapsed_ms", "findings", "initial_result_ref", "provider", "supplement_id", "window_status"],
      "properties": {
        "supplement_id": { "type": "string", "minLength": 1 },
        "initial_result_ref": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "arrival_at": { "type": "integer", "minimum": 0 },
        "arrival_elapsed_ms": { "type": "integer", "minimum": 0 },
        "window_status": { "enum": ["in_window", "over_window_unjudged"] },
        "findings": { "type": "array", "items": { "type": "object" } },
        "identity": { "$ref": "#/$defs/identity" }
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": ["adapter", "config_id", "model", "provider", "source_id"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "config_id": { "type": "string", "minLength": 1 },
        "model": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
